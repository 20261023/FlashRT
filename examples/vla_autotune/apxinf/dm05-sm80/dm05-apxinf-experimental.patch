+//! DM05 base native CUDA family. Independent of other VLA families.
+//! Equations: dexmal/opendm 03f799120d425ead51d9482bb1da950b6dabade9,
+//! Transformers 5.3 Gemma3/SigLIP. Foundation Apache-2.0 license retained.
+#[cfg(feature="cuda")] pub mod backend;
+#[cfg(feature="cuda")] pub mod weights;
+#[cfg(feature="cuda")] pub mod model;
+#[cfg(feature="cuda")] pub mod model_runner;
+pub(crate) mod load;
diff --git a/crates/apxinf-model/src/dm05/model.rs b/crates/apxinf-model/src/dm05/model.rs
new file mode 100644
--- /dev/null
+++ b/crates/apxinf-model/src/dm05/model.rs
@@ -0,0 +1,66 @@
+//! DM05 forward equations only; no graph or public-request ownership.
+use super::{backend::*,weights::{Dm05Weights,Linear,Layer,Norm}};
+use apxinf_core::{Backend,DType,Device,Error,Result,Shape,Tensor};
+use half::bf16;
+use std::sync::Arc;
+pub struct Inputs {pub patches:Tensor,pub ids:Tensor,pub positions:Tensor,pub suffix_positions:Tensor,pub prefix_mask:Tensor,pub noise:Tensor,pub action_mask:Tensor}
+pub struct Workspace {pub keys:Vec<Tensor>,pub values:Vec<Tensor>,pub latent:Tensor,pub scores:Tensor,pub probability:Tensor,pub attended:Tensor,pub n:usize}
+struct Modulation {input:Vec<Tensor>,mlp:Vec<Tensor>,last:Tensor}
+pub struct Dm05Model {pub backend:Arc<CudaBackend>,pub weights:Dm05Weights,frequency:[Tensor;2],steps:Vec<Modulation>,pub eager_math:bool}
+fn invalid(s:&str)->Error{Error::Other(format!("dm05 model: {s}"))}
+pub fn alloc(ctx:&CudaContext,dtype:DType,shape:&[usize])->Result<Tensor>{let size=shape.iter().try_fold(dtype.size_in_bytes(),|a,&b|a.checked_mul(b)).ok_or_else(||invalid("allocation overflow"))?;kernels::scratch_buffer(ctx,size)?.as_tensor(Shape::new(shape.to_vec()),dtype).map_err(Error::Cuda)}
+pub fn copy(ctx:&CudaContext,x:&Tensor,y:&Tensor)->Result<()>{if x.dtype()!=y.dtype()||x.numel()!=y.numel()||x.device()!=y.device()||x.device()!=Device::Cuda(ctx.device_id()){return Err(invalid("device copy shape/dtype/device"));}CudaBuffer::from_tensor(y).map_err(Error::Cuda)?.copy_from_device_async(&CudaBuffer::from_tensor(x).map_err(Error::Cuda)?,x.size_in_bytes(),ctx.stream()).map_err(Error::Cuda)}
+fn bf(ctx:&CudaContext,x:&Tensor)->Result<Tensor>{if x.dtype()==DType::BF16{return Ok(x.clone());}let y=alloc(ctx,DType::BF16,x.shape().dims())?;kernels::linear_attention::cast_f32_to_bf16(ctx,x,&y)?;Ok(y)}
+fn fp(ctx:&CudaContext,x:&Tensor)->Result<Tensor>{if x.dtype()==DType::F32{return Ok(x.clone());}let y=alloc(ctx,DType::F32,x.shape().dims())?;kernels::linear_attention::cast_bf16_to_f32(ctx,x,&y)?;Ok(y)}
+fn lin(ctx:&CudaContext,x:&Tensor,w:&Linear)->Result<Tensor>{
+ if w.weight.dtype()==DType::F32{let x=fp(ctx,x)?;let d=x.shape().dims();let mut y=alloc(ctx,DType::F32,&[d[0],w.weight.shape().dims()[1]])?;kernels::gemm::write(ctx,DType::F32,d[0],w.weight.shape().dims()[1],d[1],1.,&CudaBuffer::from_tensor(&x).map_err(Error::Cuda)?,&CudaBuffer::from_tensor(&w.weight).map_err(Error::Cuda)?,0.,&CudaBuffer::from_tensor(&y).map_err(Error::Cuda)?)?;if let Some(b)=&w.bias{let before=y.clone();tensor_ops::bias_f32(ctx,&before,b,&mut y)?;}return Ok(y);}
+ match &w.bias{Some(b)=>kernels::gemm::bf16_bias(ctx,x,&w.weight,b),None=>kernels::gemm::bf16(ctx,x,&w.weight)}
+}
+fn norm(ctx:&CudaContext,x:&Tensor,w:&Tensor)->Result<Tensor>{kernels::linear_attention::rms_norm_plus1(ctx,x,w,1e-6)}
+fn ln(ctx:&CudaContext,x:&Tensor,w:&Norm)->Result<Tensor>{let mut y=alloc(ctx,DType::BF16,x.shape().dims())?;tensor_ops::layer_norm_welford_bf16(ctx,x,&w.weight,&w.bias,&mut y,1e-6)?;Ok(y)}
+fn mlp(ctx:&CudaContext,x:&Tensor,l:&Layer)->Result<Tensor>{let gate=lin(ctx,x,&l.gate)?;let gate=kernels::activation::gelu_tanh(ctx,&gate)?;let up=lin(ctx,x,&l.up)?;lin(ctx,&kernels::elementwise::mul(ctx,&gate,&up)?,&l.down)}
+fn gated(ctx:&CudaContext,residual:&Tensor,branch:&Tensor,style:&Tensor)->Result<Tensor>{let gate=kernels::elementwise::contiguous_rows(ctx,&style.reshape(vec![3,1024])?,2,1)?.reshape(vec![1024])?;let mut product=alloc(ctx,DType::BF16,branch.shape().dims())?;tensor_ops::broadcast_mul_bf16(ctx,branch,&gate,&mut product)?;kernels::elementwise::add(ctx,residual,&product)}
+impl Dm05Model {
+ pub fn load(path:&std::path::Path,backend:Arc<CudaBackend>)->Result<Self>{
+  if backend.context().caps().sm!=80{return Err(invalid("first BF16 native profile requires SM80"));}
+  let weights=Dm05Weights::load(path,&backend)?;let mut freq=Vec::new();for (theta,factor) in [(10000f32,1f32),(1000000f32,8f32)]{let f=(0..128).map(|i|1./theta.powf(2.*i as f32/256.)/factor).collect::<Vec<_>>();freq.push(backend.to_device(&Tensor::from_f32(vec![128],&f)?)?);}
+  let mut result=Self{backend,weights,frequency:[freq.remove(0),freq.remove(0)],steps:Vec::new(),eager_math:std::env::var_os("APXINF_DM05_EAGER_MATH").is_some()};
+  // Fixed schedule conditioning depends on weights and ten scalar times only;
+  // compute it natively once, retaining device tensors for every replay.
+  let ctx=result.backend.context();
+  for step in 0..10{let t=bf16::from_f32((1.-step as f64*0.1) as f32).to_f32();let mut e=Vec::new();for cosine in [false,true]{for i in 0..512{let period=0.004f32*1000f32.powf(i as f32/511.);let angle=((1./period)*2.*std::f32::consts::PI)*t;e.push(bf16::from_f32(if cosine{angle.cos()}else{angle.sin()}));}}
+   let e=result.backend.to_device(&Tensor::from_bf16((1,1024),&e)?)?;let cond=kernels::activation::silu(ctx,&lin(ctx,&e,&result.weights.time_in)?)?;let cond=kernels::activation::silu(ctx,&lin(ctx,&cond,&result.weights.time_out)?)?;
+   let input=result.weights.input_mod.iter().map(|w|Ok(lin(ctx,&cond,w)?.reshape(vec![3072])?)).collect::<Result<Vec<_>>>()?;
+   let mlp=result.weights.mlp_mod.iter().map(|w|Ok(lin(ctx,&cond,w)?.reshape(vec![3072])?)).collect::<Result<Vec<_>>>()?;
+   let last=lin(ctx,&cond,&result.weights.final_mod)?.reshape(vec![3072])?;result.steps.push(Modulation{input,mlp,last});
+  }Ok(result)
+ }
+ pub fn workspace(&self,n:usize)->Result<Workspace>{let ctx=self.backend.context();let mut keys=Vec::new();let mut values=Vec::new();for _ in 0..34{keys.push(alloc(ctx,DType::BF16,&[n+50,1024])?);values.push(alloc(ctx,DType::BF16,&[n+50,1024])?);}Ok(Workspace{keys,values,latent:alloc(ctx,if self.eager_math{DType::F32}else{DType::BF16},&[50,32])?,scores:alloc(ctx,DType::F32,&[1,8,n,n])?,probability:alloc(ctx,DType::BF16,&[1,8,n,n])?,attended:alloc(ctx,DType::BF16,&[1,n,8,256])?,n})}
+ fn rotary(&self,x:&Tensor,w:&Tensor,pos:&Tensor,index:usize,heads:usize)->Result<Tensor>{let ctx=self.backend.context();let n=pos.numel();let x=norm(ctx,&x.reshape(vec![n*heads,256])?,w)?.reshape(vec![n,heads,256])?;let mut y=alloc(ctx,DType::BF16,&[n,heads,256])?;tensor_ops::rotary_rounded_bf16(ctx,&x,pos,&self.frequency[usize::from((index+1)%6==0)],&mut y)?;Ok(y)}
+ fn vision(&self,input:&Inputs)->Result<Tensor>{let ctx=self.backend.context();let mut features=Vec::new();for camera in 0..3{let patches=kernels::elementwise::contiguous_rows(ctx,&input.patches,camera*1024,1024)?;
+  let mut hidden=kernels::gemm::bf16(ctx,&patches,&self.weights.patch.weight)?;hidden=kernels::elementwise::bias_bf16(ctx,&hidden,self.weights.patch.bias.as_ref())?;hidden=kernels::elementwise::add(ctx,&hidden,&self.weights.position)?;
+  for l in &self.weights.vision{let x=ln(ctx,&hidden,&l.n1)?;let q=lin(ctx,&x,&l.q)?.reshape(vec![1024,16,72])?;let k=lin(ctx,&x,&l.k)?.reshape(vec![1024,16,72])?;let v=lin(ctx,&x,&l.v)?.reshape(vec![1024,16,72])?;let a=kernels::attention::mha_bf16(ctx,&q,&k,&v,1024)?.reshape(vec![1024,1152])?;hidden=kernels::elementwise::add(ctx,&hidden,&lin(ctx,&a,&l.o)?)?;let x=ln(ctx,&hidden,&l.n2)?;let x=kernels::activation::gelu_tanh(ctx,&lin(ctx,&x,&l.fc1)?)?;hidden=kernels::elementwise::add(ctx,&hidden,&lin(ctx,&x,&l.fc2)?)?;}
+  let hidden=ln(ctx,&hidden,&self.weights.vision_norm)?.reshape(vec![1,32,32,1152])?;let mut pooled=alloc(ctx,DType::BF16,&[1,16,16,1152])?;tensor_ops::avg_pool2_bf16(ctx,&hidden,&mut pooled)?;let pooled=norm(ctx,&pooled.reshape(vec![256,1152])?,&self.weights.projector_norm)?;features.push(kernels::gemm::bf16(ctx,&pooled,&self.weights.projector)?);
+ }let f=kernels::elementwise::concat_rows_bf16(ctx,&features[0],&features[1])?;kernels::elementwise::concat_rows_bf16(ctx,&f,&features[2])}
+ pub fn forward(&self,input:&Inputs,work:&mut Workspace,image_rows:&kernels::elementwise::PreparedRowIndices)->Result<Tensor>{
+  let ctx=self.backend.context();let n=work.n;let vision=self.vision(input)?;
+  let mut hidden=alloc(ctx,DType::BF16,&[n,2560])?;apxinf_cuda_new::ops::embedding_gather(ctx,&self.weights.embedding,&input.ids,&hidden)?;
+  hidden=kernels::elementwise::scale(ctx,&hidden,bf16::from_f32(2560f32.sqrt()).to_f32())?;hidden=kernels::elementwise::scatter_rows_bf16_prepared(ctx,&hidden,image_rows,&vision,false)?;
+  for (i,l) in self.weights.prefix.iter().enumerate(){let x=norm(ctx,&hidden,&l.input)?;let q=self.rotary(&lin(ctx,&x,&l.q)?,&l.qnorm,&input.positions,i,8)?;let k=self.rotary(&lin(ctx,&x,&l.k)?,&l.knorm,&input.positions,i,4)?;let v=lin(ctx,&x,&l.v)?;
+   copy(ctx,&k.reshape(vec![n,1024])?,&kernels::elementwise::contiguous_rows(ctx,&work.keys[i],0,n)?)?;copy(ctx,&v,&kernels::elementwise::contiguous_rows(ctx,&work.values[i],0,n)?)?;
+   let q=fp(ctx,&q)?.reshape(vec![1,n,8,256])?;let k=fp(ctx,&k)?.reshape(vec![1,n,4,256])?;
+   kernels::attention::eager_staged_bf16(ctx,&q,&k,&v.reshape(vec![1,n,4,256])?,&input.prefix_mask,&mut work.scores,&mut work.probability,&mut work.attended,0.0625)?;
+   let a=lin(ctx,&work.attended.reshape(vec![n,2048])?,&l.o)?;hidden=kernels::elementwise::add(ctx,&hidden,&norm(ctx,&a,&l.post_attention)?)?;let x=norm(ctx,&hidden,&l.pre_ff)?;hidden=kernels::elementwise::add(ctx,&hidden,&norm(ctx,&mlp(ctx,&x,l)?,&l.post_ff)?)?;
+  }
+  let noise=if self.eager_math{input.noise.clone()}else{bf(ctx,&input.noise)?};copy(ctx,&noise,&work.latent)?;
+  let mask=if self.eager_math{input.action_mask.clone()}else{bf(ctx,&input.action_mask)?};
+  for step in 0..10{let style=&self.steps[step];let masked=kernels::elementwise::mul(ctx,&work.latent,&mask)?;copy(ctx,&masked,&work.latent)?;let input_weight=if self.eager_math{&self.weights.action_in}else{&self.weights.action_in_bf16};let mut hidden=bf(ctx,&lin(ctx,&work.latent,input_weight)?)?;
+   for (i,l) in self.weights.action.iter().enumerate(){let x=kernels::norm::adaptive_rms_bf16(ctx,&hidden,&style.input[i],1e-6)?;let q=self.rotary(&lin(ctx,&x,&l.q)?,&l.qnorm,&input.suffix_positions,i,8)?;let k=self.rotary(&lin(ctx,&x,&l.k)?,&l.knorm,&input.suffix_positions,i,4)?;let v=lin(ctx,&x,&l.v)?;
+    copy(ctx,&k.reshape(vec![50,1024])?,&kernels::elementwise::contiguous_rows(ctx,&work.keys[i],n,50)?)?;copy(ctx,&v,&kernels::elementwise::contiguous_rows(ctx,&work.values[i],n,50)?)?;
+    let a=kernels::attention::full_gqa_bf16(ctx,&q,&work.keys[i].reshape(vec![n+50,4,256])?,&work.values[i].reshape(vec![n+50,4,256])?)?.reshape(vec![50,2048])?;
+    let a=norm(ctx,&lin(ctx,&a,&l.o)?,&l.post_attention)?;hidden=gated(ctx,&hidden,&a,&style.input[i])?;let x=kernels::norm::adaptive_rms_bf16(ctx,&hidden,&style.mlp[i],1e-6)?;let x=norm(ctx,&mlp(ctx,&x,l)?,&l.post_ff)?;hidden=gated(ctx,&hidden,&x,&style.mlp[i])?;
+   }
+   let hidden=kernels::norm::adaptive_rms_bf16(ctx,&hidden,&style.last,1e-6)?;let output_weight=if self.eager_math{&self.weights.action_out}else{&self.weights.action_out_bf16};let velocity=lin(ctx,&hidden,output_weight)?;let delta=kernels::elementwise::scale(ctx,&velocity,-0.1)?;let next=kernels::elementwise::add(ctx,&work.latent,&delta)?;copy(ctx,&next,&work.latent)?;
+  }Ok(work.latent.clone())
+ }
+}
diff --git a/crates/apxinf-model/src/dm05/model_runner.rs b/crates/apxinf-model/src/dm05/model_runner.rs
new file mode 100644
--- /dev/null
+++ b/crates/apxinf-model/src/dm05/model_runner.rs
@@ -0,0 +1,74 @@
+//! Fixed-profile owning execution, request binding, graph and cache lifetimes.
+use super::{backend::*,model::{Dm05Model,Inputs,Workspace}};
+use crate::vla::*;
+use apxinf_core::{Backend,DType,Device,Error,Graph,NormalGenerator,SamplingBackend,Result,Shape,Tensor};
+use half::bf16;
+use std::{cell::RefCell,rc::Rc,sync::Arc};
+fn invalid(s:&str)->Error{Error::Other(format!("dm05 runtime: {s}"))}
+fn cpu_f32(t:&Tensor)->Result<Tensor>{if t.device()!=Device::Cpu{return Err(invalid("public inputs must be CPU tensors"));}Tensor::from_f32(t.shape().clone(),&t.to_f32_vec()?)}
+fn cpu_bf16(t:&Tensor)->Result<Tensor>{if t.device()!=Device::Cpu{return Err(invalid("patches must be CPU tensors"));}Tensor::from_bf16(t.shape().clone(),&t.to_f32_vec()?.into_iter().map(bf16::from_f32).collect::<Vec<_>>())}
+struct Resources {graph:Option<Box<dyn Graph>>,output:Option<Tensor>,arena:kernels::GraphWorkspace,inputs:Inputs,work:Workspace,image_rows:kernels::elementwise::PreparedRowIndices,image_offsets:Vec<usize>,normal_generator:Box<dyn NormalGenerator>}
+pub struct Dm05Prepared {resources:RefCell<Resources>,model:Rc<Dm05Model>,spec:InferenceSpec,mode:ExecutionMode,tuning_session:Arc<apxinf_cuda::tuning::TuningSession>,tuning_generation:u64}
+pub struct Dm05ModelRunner {model:Rc<Dm05Model>,prepared:RefCell<Option<Rc<Dm05Prepared>>>}
+fn bind(model:&Dm05Model,r:&mut Resources,request:&VlaRequest<'_>)->Result<()>{
+ let o=request.observation;let n=r.work.n;let backend=&model.backend;
+ if o.token_ids.len()!=n || o.token_ids.iter().any(|&v|v==0||v==7||v>=262208){return Err(invalid("first native profile requires unpadded valid no-history token IDs"));}
+ if request.metadata.attention_mask.is_some_and(|m|m.len()!=n||m.iter().any(|&x|x!=1)){return Err(invalid("first native profile requires all-visible suffix prefix keys"));}
+ let offsets=o.token_ids.iter().enumerate().filter_map(|(i,&id)|(id==262144).then_some(i)).collect::<Vec<_>>();if offsets!=r.image_offsets{return Err(invalid("image token offsets differ from prepared profile"));}
+ let patches=match &o.vision{VisionObservation::Patches(t)=>t,_=>return Err(invalid("canonical patch tensors required"))};if patches.shape().dims()!=[3072,588]{return Err(invalid("expected3x1024x588 CHW patch rows"));}
+ transfers::copy_cpu_to_cuda(&cpu_bf16(patches)?,&r.inputs.patches)?;
+ transfers::copy_cpu_to_cuda(&Tensor::from_i32(vec![n],&o.token_ids.iter().map(|&x|if x==262144{0}else{x as i32}).collect::<Vec<_>>())?,&r.inputs.ids)?;
+ let mask=if let Some(t)=&o.action_mask{let v=t.to_f32_vec()?;if v.len()==32{v.repeat(50)}else if v.len()==1600{v}else{return Err(invalid("action mask must have32or1600values"));}}else{vec![1.;1600]};
+ if mask.iter().any(|&x|x!=0.&&x!=1.){return Err(invalid("action mask must be binary"));}
+ transfers::copy_cpu_to_cuda(&Tensor::from_f32((50,32),&mask)?,&r.inputs.action_mask)?;
+ match request.initial_latent{InitialLatent::Provided(t)=>{if t.numel()!=1600{return Err(invalid("provided noise must have50x32values"));}transfers::copy_cpu_to_cuda(&cpu_f32(t)?.reshape(vec![50,32])?,&r.inputs.noise)?;},InitialLatent::Generate{rng}=>{r.normal_generator.generate(rng)?;}}
+ Ok(())
+}
+impl Dm05ModelRunner {
+ pub fn new(model:Dm05Model)->Self{Self{model:Rc::new(model),prepared:RefCell::new(None)}}
+ pub fn backend(&self)->&CudaBackend{&self.model.backend}
+ pub fn prepare_request(&self,sample:&VlaRequest<'_>,policy:ExecutionPolicy)->Result<Dm05Prepared>{
+  let spec=sample.observation.inference_spec();let n=spec.token_count;
+  if spec.image_layout.is_some()||n<768||n+50>1024{return Err(invalid("native fixed prefix must have768..974tokens"));}
+  let offsets=sample.observation.token_ids.iter().enumerate().filter_map(|(i,&id)|(id==262144).then_some(i)).collect::<Vec<_>>();if offsets.len()!=768{return Err(invalid("three images must occupy768image tokens"));}
+  let b=&self.model.backend;let device=b.device_id();let f=|shape:Vec<usize>,dtype|b.to_device(&Tensor::zeros(shape,dtype));
+  let mut groups=vec![-1i32;n];let mut group=-1;for i in 0..n{if sample.observation.token_ids[i]==262144{if i==0||sample.observation.token_ids[i-1]!=262144{group+=1;}groups[i]=group;}}
+  let mask=(0..n).flat_map(|q|{let groups=&groups;(0..n).map(move|k|i8::from(k<=q||(groups[q]>=0&&groups[q]==groups[k])))}).collect::<Vec<_>>();
+  let inputs=Inputs{patches:f(vec![3072,588],DType::BF16)?,ids:f(vec![n],DType::I32)?,positions:b.to_device(&Tensor::from_i32(vec![n],&(0..n).map(|x|x as i32).collect::<Vec<_>>())?)?,suffix_positions:b.to_device(&Tensor::from_i32(vec![50],&(n..n+50).map(|x|x as i32).collect::<Vec<_>>())?)?,prefix_mask:b.to_device(&Tensor::from_i8((1,n,n),&mask)?)?,noise:f(vec![50,32],DType::F32)?,action_mask:f(vec![50,32],DType::F32)?};
+  let rows=kernels::elementwise::prepare_row_indices(b.context(),&offsets,n)?;
+  let capacity=std::env::var("APXINF_DM05_ARENA_GIB").ok().and_then(|s|s.parse::<usize>().ok()).unwrap_or(16);
+  let normal_generator=b.create_normal_generator(inputs.noise.clone())?;
+  let mut r=Resources{graph:None,output:None,arena:kernels::GraphWorkspace::new(capacity<<30,device)?,inputs,work:self.model.workspace(n)?,image_rows:rows,image_offsets:offsets,normal_generator};
+  bind(&self.model,&mut r,sample)?;
+  kernels::prepare_with_workspace(&r.arena,||self.model.forward(&r.inputs,&mut r.work,&r.image_rows))?;b.synchronize()?;
+  let mode=if policy!=ExecutionPolicy::Eager{let (graph,output)=b.capture_graph(||kernels::with_workspace(&r.arena,||self.model.forward(&r.inputs,&mut r.work,&r.image_rows)))?;r.graph=Some(graph);r.output=Some(output);ExecutionMode::Graph}else{ExecutionMode::Eager};
+  eprintln!("[dm05] prepared {:?}; arena_used={} capacity={}",mode,r.arena.used(),r.arena.capacity());
+  let tuning_session=b.context().tuning();let tuning_generation=tuning_session.generation();
+  Ok(Dm05Prepared{resources:RefCell::new(r),model:Rc::clone(&self.model),spec,mode,tuning_session,tuning_generation})
+ }
+}
+impl Dm05Prepared {pub fn arena_used(&self)->usize{self.resources.borrow().arena.used()}fn is_current(&self)->bool{let current=self.model.backend.context().tuning();Arc::ptr_eq(&current,&self.tuning_session)&&current.generation()==self.tuning_generation}}
+impl Drop for Dm05Prepared{fn drop(&mut self){let _=self.model.backend.synchronize();}}
+impl PreparedInference for Dm05Prepared {
+ fn spec(&self)->&InferenceSpec{&self.spec}
+ fn status(&self)->PreparationStatus{if self.is_current(){PreparationStatus::Ready{mode:self.mode,fallback_reason:None}}else{PreparationStatus::Invalidated}}
+ fn run(&self,request:&VlaRequest<'_>)->Result<Action>{
+  if !self.is_current(){return Err(invalid("prepared graph is stale after tuning session/generation change"));}
+  if !self.spec.matches(request.observation){return Err(invalid("request shape differs from prepared profile"));}
+  let mut r=self.resources.try_borrow_mut().map_err(|_|invalid("prepared runs must be serialized"))?;
+  self.model.backend.synchronize()?;bind(&self.model,&mut r,request)?;
+  if let Some(g)=&r.graph{g.replay()?;return Ok(Action::new(r.output.as_ref().unwrap().clone()));}
+  let Resources{arena,inputs,work,image_rows,..}=&mut *r;
+  kernels::with_workspace(arena,||self.model.forward(inputs,work,image_rows)).map(Action::new)
+ }
+}
+impl VlaRuntime for Dm05ModelRunner {
+ fn model_variant(&self)->Option<&'static str>{Some("bf16")}
+ fn contract(&self)->VlaContract{VlaContract{action_shape:[50,32],patch_shape:[3072,588],max_token_len:974,num_views:3,image_size:448,patch_size:14,accepts_rgb_u8:false}}
+ fn infer(&self,request:&VlaRequest<'_>)->Result<Action>{let plan=self.prepared.borrow().as_ref().filter(|p|p.is_current()&&p.spec.matches(request.observation)).cloned();let p=if let Some(p)=plan{p}else{let p=Rc::new(self.prepare_request(request,ExecutionPolicy::RequireGraph)?);*self.prepared.borrow_mut()=Some(Rc::clone(&p));p};p.run(request)}
+ fn prepare(&self,_:&InferenceSpec)->Result<Box<dyn PreparedInference>>{Err(invalid("use prepare_for with actual image token offsets"))}
+ fn prepare_for(&self,sample:&VlaRequest<'_>,policy:ExecutionPolicy)->Result<Box<dyn PreparedInference>>{Ok(Box::new(self.prepare_request(sample,policy)?))}
+ fn clear_prepared(&self)->Result<()>{self.model.backend.synchronize()?;self.prepared.borrow_mut().take();Ok(())}
+ fn execution_mode(&self)->&'static str{if self.prepared.borrow().is_some(){"graph"}else{"unprepared"}}
+ fn infer_host_f32(&self,r:&VlaRequest<'_>)->Result<Vec<f32>>{let a=self.infer(r)?;self.model.backend.to_cpu(a.tensor())?.to_f32_vec()}
+}
