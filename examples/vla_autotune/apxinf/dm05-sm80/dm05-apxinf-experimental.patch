@@ -0,0 +1,86 @@
+"""DM05 base policy: author CPU transforms -> ApxInf-native Rust/CUDA model.
+
+The optional OpenDM dependency supplies only CPU public input/output transforms.
+No Torch model, Torch graph or external inference engine is constructed here.
+"""
+from __future__ import annotations
+
+import time
+from pathlib import Path
+import numpy as np
+from ..registry import register_policy
+
+
+@register_policy("dm05")
+class Dm05Policy:
+    @classmethod
+    def from_pretrained(cls, checkpoint_dir, *, model_runner=None,
+                        preprocessing=None, norm_stats_path=None,
+                        device="cuda:0", sampling_seed=0, model_variant="bf16"):
+        root = Path(checkpoint_dir)
+        if model_variant not in ("bf16", "auto"):
+            raise ValueError("DM05 base native supports BF16 only")
+        if preprocessing is None:
+            if norm_stats_path is None:
+                norm_stats_path = root / "norm_stats.json"
+            # The official preprocessing-only constructor does not load or move
+            # any model. It returns CPU tensors; all model execution is native.
+            from opendm.exp.dm05_exp import DM05InferenceConfig
+            preprocessing = DM05InferenceConfig()
+            preprocessing._initialize_preprocessing(
+                model_name_or_path=str(root), norm_stats_path=str(norm_stats_path),
+                n_bins=256, transform_max_length=1024, use_absolute_action=True,
+                add_state=True, is_history=False, device="cpu")
+        if model_runner is None:
+            from apxinf import ModelRunner
+            model_runner = ModelRunner.load("dm05", root, device=device,
+                precision="bf16", model_variant="bf16", sampling_seed=sampling_seed)
+        if model_runner.action_horizon != 50 or model_runner.action_dim != 32:
+            raise ValueError("DM05 native runner must produce50x32 normalized actions")
+        return cls(model_runner, preprocessing)
+
+    def __init__(self, model_runner, preprocessing):
+        self.model_runner, self.preprocessing = model_runner, preprocessing
+        self.action_horizon, self.action_dim = 50, 14
+        self.metadata = {"model_type": "dm05", "model_variant": "bf16",
+            "action_horizon": 50, "action_dim": 14, "state_dim": 14,
+            "history_length": 0, "execution": "ApxInf-native Rust CUDA",
+            "action_domain": "author absolute public14"}
+
+    def infer(self, observation, *, noise=None):
+        start = time.perf_counter()
+        p = self.preprocessing
+        data = p._prepare_model_input(text=observation["prompt"],
+            images=observation["images"], states=observation["state"],
+            robot_type=observation.get("robot_type", "DOS W1"))
+        state = np.array(data["state"], copy=True)
+        inputs = p.input_transform(data)
+        pixels = inputs["pixel_values"].detach().cpu().float().numpy()
+        if pixels.shape != (3, 3, 448, 448):
+            raise ValueError("DM05 native supports exactly three448x448 images and no history")
+        # CHW convolution K order; native runtime rounds public F32 patches BF16.
+        patches = np.ascontiguousarray(pixels.reshape(3,3,32,14,32,14)
+            .transpose(0,2,4,1,3,5).reshape(3072,588))
+        ids = np.ascontiguousarray(inputs["input_ids"].detach().cpu().numpy().reshape(-1), dtype=np.uint32)
+        visibility = np.ascontiguousarray(inputs["attention_mask"].detach().cpu().numpy().reshape(-1), dtype=np.uint8)
+        if not visibility.all() or np.any((ids == 0) | (ids == 7)):
+            raise ValueError("first native DM05 profile requires unpadded no-history requests")
+        types = inputs["token_type_ids"].detach().cpu().numpy().reshape(-1)
+        if not np.array_equal(types == 1, ids == 262144):
+            raise ValueError("unsupported Gemma3 image token type layout")
+        mask = np.zeros((50,32), dtype=np.float32); mask[:,:14] = 1
+        if noise is not None:
+            noise = np.ascontiguousarray(noise, dtype=np.float32).reshape(50,32)
+        model_start = time.perf_counter()
+        normalized = self.model_runner._infer_preprocessed(patches,
+            np.array([[1,32,32]]*3, dtype=np.uint32), ids, visibility,
+            np.zeros((1,32), dtype=np.float32), None, noise, action_mask=mask)
+        model_ms = (time.perf_counter()-model_start)*1000
+        normalized = np.asarray(normalized, dtype=np.float32).reshape(50,32)
+        if not np.isfinite(normalized).all():
+            raise RuntimeError("non-finite DM05 native output")
+        outputs = p.output_transform({"action": normalized[:,:14].copy(),
+            "state": state, "meta_data": data["meta_data"]})
+        actions = np.ascontiguousarray(outputs["action"], dtype=np.float32)
+        return {"actions": actions, "action_domain": "author absolute public14",
+            "timing": {"model_ms": model_ms, "total_ms": (time.perf_counter()-start)*1000}}
