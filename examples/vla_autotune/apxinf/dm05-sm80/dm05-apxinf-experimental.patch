+# PUBLIC post-measurement adapter. NOT RUN/imported during packaging.
+"""Arithmetic and inventory on already-saved formal outputs; no model runs."""
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    p=argparse.ArgumentParser()
+    p.add_argument("--reference",type=Path,required=True)
+    p.add_argument("--core",type=Path,required=True)
+    p.add_argument("--public",type=Path,required=True)
+    p.add_argument("--output",type=Path,required=True)
+    a=p.parse_args()
+    import numpy as np
+    rows=[]
+    arrays={}
+    normalized={}
+    for case in ("demo-seed0","demo-seed17","state-seed0","prompt-seed0"):
+        author=np.load(a.reference/case/"actions.npy")
+        actual=np.load(a.public/f"{case}-actions.npy")
+        core=np.load(a.core/f"{case}-public14.npy")
+        record=json.loads((a.core/f"{case}.json").read_text())
+        norm=np.asarray(record["normalized_actions"],dtype=np.float32).reshape(10,50,32)
+        arrays[case]=actual; normalized[case]=norm
+        comparisons=[]
+        for x,y in zip(actual,author,strict=True):
+            x=x.astype(np.float64).ravel(); y=y.astype(np.float64).ravel()
+            comparisons.append({"relL2":float(np.linalg.norm(x-y)/max(np.linalg.norm(y),1e-30)),
+                "cosine":float(x@y/max(np.linalg.norm(x)*np.linalg.norm(y),1e-30)),
+                "max_abs":float(np.max(np.abs(x-y)))})
+        row={"case":case,"shape":list(actual.shape),"dtype":str(actual.dtype),
+             "all_finite":bool(np.isfinite(actual).all() and np.isfinite(norm).all()),
+             "repeat_max_abs":float(np.max(np.abs(actual-actual[0:1]))),
+             "normalized_repeat_max_abs":float(np.max(np.abs(norm-norm[0:1]))),
+             "core_public_exact_equal":bool(np.array_equal(actual,core)),
+             "worst_relL2":max(x["relL2"] for x in comparisons),
+             "minimum_cosine":min(x["cosine"] for x in comparisons),
+             "max_abs_vs_author":max(x["max_abs"] for x in comparisons),
+             "arena_used_bytes":record["arena_used_bytes"]}
+        row["budget_met"]=row["all_finite"] and row["worst_relL2"]<=0.05 and row["minimum_cosine"]>=0.999
+        rows.append(row)
+    changes={}
+    for case in ("demo-seed17","state-seed0","prompt-seed0"):
+        delta=arrays[case][0].astype(np.float64)-arrays["demo-seed0"][0].astype(np.float64)
+        ndelta=normalized[case][0,:,:14].astype(np.float64)-normalized["demo-seed0"][0,:,:14].astype(np.float64)
+        changes[case]={"public14_max_abs_change":float(np.max(np.abs(delta))),
+                       "public14_L2_change":float(np.linalg.norm(delta)),
+                       "normalized_public14_max_abs_change":float(np.max(np.abs(ndelta)))}
+    result={"scope":"CPU arithmetic on saved formal inference outputs only",
+            "all_four_cases_budget_met":all(r["budget_met"] for r in rows),
+            "cases":rows,"changed_input_outputs":changes,"tests_run":False,
+            "additional_model_runs":0,"closed_loop_success":"NR"}
+    a.output.write_text(json.dumps(result,indent=2)+"\n")
+    print(json.dumps(result,indent=2))
+
+
+if __name__=="__main__":
+    main()
