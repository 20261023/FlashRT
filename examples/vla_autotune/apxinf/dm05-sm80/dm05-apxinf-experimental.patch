+    policy = DM05InferenceConfig()
+    policy._initialize_preprocessing(model_name_or_path=str(args.checkpoint),
+        norm_stats_path=str(args.checkpoint/"norm_stats.json"), n_bins=256,
+        transform_max_length=1024, use_absolute_action=True, add_state=True,
+        is_history=False, device="cpu")
+    # _prepare_model_input only needs image count and public state metadata for
+    # output reconstruction; no image tensor computation or inference follows.
+    images = [Image.new("RGB", (1,1)) for _ in range(3)]
+    rows = []
+    for case in reference["cases"]:
+        name = case["id"]
+        native = json.loads((args.native/f"{name}.json").read_text())
+        normalized = np.asarray(native["normalized_actions"], dtype=np.float32).reshape(-1,50,32)
+        data = policy._prepare_model_input(text=case["prompt"], images=images,
+            states=case["state"], robot_type="DOS W1")
+        actions = np.stack([policy.output_transform({"action":a[:,:14].copy(),
+            "state":np.array(data["state"],copy=True),"meta_data":data["meta_data"]})["action"]
+            for a in normalized])
+        expected = np.load(args.reference/name/"actions.npy")
+        comparisons = []
+        for i, action in enumerate(actions):
+            a = action.astype(np.float64).ravel()
+            b = expected[min(i,len(expected)-1)].astype(np.float64).ravel()
+            rel = float(np.linalg.norm(a-b)/max(np.linalg.norm(b),1e-30))
+            cosine = float(a@b/max(np.linalg.norm(a)*np.linalg.norm(b),1e-30))
+            comparisons.append({"sample":i,"relL2":rel,"cosine":cosine,
+                "max_abs":float(np.max(np.abs(a-b))),"finite":bool(np.isfinite(a).all())})
+        np.save(args.native/f"{name}-public14.npy", actions)
+        row = {"case":name,"comparisons":comparisons,
+            "passed":all(c["finite"] and c["relL2"]<=0.05 and c["cosine"]>=0.999 for c in comparisons),
+            "median_canonical_cpu_to_normalized_cpu_ms":float(np.median(native["samples_ms"]))}
+        rows.append(row)
+    report = {"native":str(args.native),"reference":str(args.reference),
+        "boundary":"saved complete public14 author absolute CPU actions",
+        "relL2_limit":0.05,"cosine_minimum":0.999,"cases":rows,
+        "passed":all(r["passed"] for r in rows),"tests_run":False,
+        "evidence":"arithmetic on formal model inference outputs, no tests or extra model runs"}
+    (args.native/"public14-comparison.json").write_text(json.dumps(report,indent=2)+"\n")
+    print(json.dumps(report,indent=2))
+
+
+if __name__ == "__main__":
+    main()
