+use crate::{LoadOptions,LoadedModel,ModelPrecision};
+use apxinf_core::{Backend,Device,Error,Result};
+use std::{path::Path,sync::Arc};
+pub(crate) fn load_registered(path:&Path,device:Device,backend:Arc<dyn Backend>,options:&LoadOptions)->Result<LoadedModel>{
+ if !matches!(options.precision,ModelPrecision::Auto|ModelPrecision::Bf16)||!matches!(options.model_variant.as_deref(),None|Some("auto")|Some("bf16"))||options.config.is_some()||options.synthetic.is_some()||options.uniform_fp8_scale.is_some()||options.calibration_path.is_some()||options.text_weight_dtype.is_some()||!options.assets.is_empty(){return Err(Error::Other("DM05 native supports fixed base BF16 checkpoint only".into()));}
+ #[cfg(feature="cuda")]{let _=device;let backend=crate::accelerator::cuda::downcast_arc(backend).ok_or_else(||Error::Other("DM05 native requires CUDA".into()))?;let model=super::model::Dm05Model::load(path,backend)?;Ok(LoadedModel::Vla(Box::new(super::model_runner::Dm05ModelRunner::new(model))))}
+ #[cfg(not(feature="cuda"))]{let _=(path,device,backend);Err(Error::Other("DM05 native requires CUDA feature".into()))}
+}
