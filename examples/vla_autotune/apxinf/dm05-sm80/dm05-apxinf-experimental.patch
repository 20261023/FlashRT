+fn err(s:impl Into<String>)->Error{Error::Other(format!("dm05 weights: {}",s.into()))}
+struct Loader<'a>{map:HashMap<String,Tensor>,backend:&'a CudaBackend}
+impl Loader<'_>{
+ fn take(&mut self,name:&str,shape:&[usize])->Result<Tensor>{
+  let t=self.map.remove(name).ok_or_else(||err(format!("missing {name}")))?;
+  if t.device()!=Device::Cpu || t.dtype()!=DType::BF16 || t.shape().dims()!=shape{return Err(err(format!("{name} expected BF16 {shape:?}, got {} {:?}",t.dtype(),t.shape().dims())));}
+  Ok(t)
+ }
+ fn tensor(&mut self,name:&str,shape:&[usize])->Result<Tensor>{let t=self.take(name,shape)?;self.backend.to_device(&t)}
+ fn linear(&mut self,name:&str,input:usize,output:usize,bias:bool,f32_weight:bool)->Result<Linear>{
+  let t=self.take(&format!("{name}.weight"),&[output,input])?;
+  let v=t.as_bf16()?;let mut packed=vec![bf16::ZERO;v.len()];
+  for i in 0..output{for j in 0..input{packed[j*output+i]=v[i*input+j];}}
+  let w=if f32_weight{Tensor::from_f32((input,output),&packed.iter().map(|v|v.to_f32()).collect::<Vec<_>>())?}else{Tensor::from_bf16((input,output),&packed)?};
+  let b=if bias{let b=self.take(&format!("{name}.bias"),&[output])?;Some(self.backend.to_device(&if f32_weight{Tensor::from_f32(vec![output],&b.to_f32_vec()?)?}else{b})?)}else{None};
+  Ok(Linear{weight:self.backend.to_device(&w)?,bias:b})
+ }
+ fn norm(&mut self,name:&str,width:usize)->Result<Norm>{Ok(Norm{weight:self.tensor(&format!("{name}.weight"),&[width])?,bias:self.tensor(&format!("{name}.bias"),&[width])?})}
+ fn layer(&mut self,name:&str,d:usize,ff:usize)->Result<Layer>{
+  Ok(Layer{input:self.tensor(&format!("{name}.input_layernorm.weight"),&[d])?,post_attention:self.tensor(&format!("{name}.post_attention_layernorm.weight"),&[d])?,pre_ff:self.tensor(&format!("{name}.pre_feedforward_layernorm.weight"),&[d])?,post_ff:self.tensor(&format!("{name}.post_feedforward_layernorm.weight"),&[d])?,
+   qnorm:self.tensor(&format!("{name}.self_attn.q_norm.weight"),&[256])?,knorm:self.tensor(&format!("{name}.self_attn.k_norm.weight"),&[256])?,
+   q:self.linear(&format!("{name}.self_attn.q_proj"),d,2048,false,false)?,k:self.linear(&format!("{name}.self_attn.k_proj"),d,1024,false,false)?,v:self.linear(&format!("{name}.self_attn.v_proj"),d,1024,false,false)?,o:self.linear(&format!("{name}.self_attn.o_proj"),2048,d,false,false)?,
+   gate:self.linear(&format!("{name}.mlp.gate_proj"),d,ff,false,false)?,up:self.linear(&format!("{name}.mlp.up_proj"),d,ff,false,false)?,down:self.linear(&format!("{name}.mlp.down_proj"),ff,d,false,false)?})
+ }
+}
