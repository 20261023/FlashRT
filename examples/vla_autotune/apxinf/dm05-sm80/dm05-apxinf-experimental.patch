+++ b/python/apxinf/examples/dm05_experimental/prepare_inputs.py
@@ -0,0 +1,59 @@
+# PUBLIC post-measurement adapter. NOT RUN/imported during packaging.
+"""Serialize caller-supplied saved formal inputs; never run a model or inference.
+
+Public CPU patchification/serialization only. The exact initial BF16 noise and
+all prepared IDs come from the completed official author run, not regenerated RNG.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    import torch
+    from safetensors.torch import save_file
+    report = json.loads((args.reference / "result.json").read_text())
+    records = []
+    for case in report["cases"]:
+        name = case["id"]
+        root = args.reference / name
+        prepared = torch.load(root / "prepared.pt", map_location="cpu", weights_only=True)
+        noise = torch.load(root / "initial_noise.pt", map_location="cpu", weights_only=True)
+        pixels = prepared["pixel_values"]
+        if list(pixels.shape) != [3, 3, 448, 448]:
+            raise ValueError(f"unsupported public pixel shape {pixels.shape}")
+        # The original convolution casts pixel values to BF16 before compute.
+        pixels = pixels.to(torch.bfloat16)
+        patches = pixels.reshape(3,3,32,14,32,14).permute(0,2,4,1,3,5).reshape(3072,588).contiguous()
+        # ApxInf's existing safetensors fixture reader admits F32/BF16, not I32.
+        # Token IDs (<262208) are exactly representable in F32; the benchmark
+        # decodes them to u32 before the model runtime uploads native I32 IDs.
+        ids = prepared["input_ids"].reshape(-1).to(torch.float32).contiguous()
+        types = prepared["token_type_ids"].reshape(-1)
+        if not torch.equal(types == 1, ids == 262144):
+            raise ValueError("first native profile requires image token types at image placeholders only")
+        mask = torch.zeros((50,32), dtype=torch.float32)
+        mask[:,:14] = 1
+        destination = args.output / name
+        destination.mkdir(parents=True, exist_ok=False)
+        save_file({"input_ids": ids, "patches": patches,
+                   "initial_noise": noise.reshape(50,32).contiguous(),
+                   "action_mask": mask}, str(destination / "inputs.safetensors"))
+        records.append({"case": name, "prefix_length": len(ids),
+                        "token_id_storage":"F32 exact integer encoding (<262208); native runtime uses I32",
+                        "prepared_sha256": hashlib.sha256((root/"prepared.pt").read_bytes()).hexdigest(),
+                        "noise_sha256": hashlib.sha256((root/"initial_noise.pt").read_bytes()).hexdigest()})
+    (args.output/"manifest.json").write_text(json.dumps({"reference":str(args.reference),
+        "source_revision":report["source_revision"], "checkpoint_revision":report["checkpoint_revision"],
+        "suffix_graph_profiles":report["suffix_graph_profiles"],
+        "suffix_graph_disabled_profiles":report["suffix_graph_disabled_profiles"],
+        "cases":records, "tests_run":False}, indent=2)+"\n")
+
+
+if __name__ == "__main__":
+    main()
