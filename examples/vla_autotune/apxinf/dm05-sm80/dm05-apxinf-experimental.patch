+  let vision_norm=l.norm(&format!("{vp}.post_layernorm"),1152)?;
+  let projector_norm=l.tensor("model.vlm.model.multi_modal_projector.mm_soft_emb_norm.weight",&[1152])?;
+  let projector=l.tensor("model.vlm.model.multi_modal_projector.mm_input_projection_weight",&[1152,2560])?;
+  let embedding=l.tensor("model.vlm.model.language_model.embed_tokens.weight",&[262208,2560])?;
+  let mut prefix=Vec::new();let mut action=Vec::new();let mut input_mod=Vec::new();let mut mlp_mod=Vec::new();
