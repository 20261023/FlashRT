+namespace {
+__global__ void rounded_rope_kernel(const B*x,const int32_t*p,const float*f,B*y,int64_t n,int heads,int dim) {
+ for(int64_t i=int64_t(blockIdx.x)*blockDim.x+threadIdx.x;i<n;i+=int64_t(blockDim.x)*gridDim.x) {
+  int c=i%dim,half=dim/2;int64_t base=i-c;float angle=__fmul_rn(float(p[i/(heads*dim)]),f[c%half]);
+  B co=__float2bfloat16_rn(cosf(angle)),si=__float2bfloat16_rn(sinf(angle));
+  B other=x[base+(c+half)%dim];if(c<half)other=__float2bfloat16_rn(-load(other));
+  y[i]=__hadd(__hmul(x[i],co),__hmul(other,si));
+ }
+}
+__global__ void avg2_kernel(const B*x,B*y,int64_t n,int h,int w,int c) {
+ for(int64_t i=int64_t(blockIdx.x)*blockDim.x+threadIdx.x;i<n;i+=int64_t(blockDim.x)*gridDim.x) {
+  int ch=i%c,ow=(i/c)%(w/2),oh=(i/(c*(w/2)))%(h/2),b=i/(int64_t(c)*(w/2)*(h/2));
+  int64_t at=((int64_t(b)*h+oh*2)*w+ow*2)*c+ch;
+  float s=__fadd_rn(__fadd_rn(__fadd_rn(load(x[at]),load(x[at+c])),load(x[at+w*c])),load(x[at+w*c+c]));
+  y[i]=__float2bfloat16_rn(s*.25f);
+ }
+}
+__global__ void bias32_kernel(const float*x,const float*b,float*y,int64_t n,int c) {
+ for(int64_t i=int64_t(blockIdx.x)*blockDim.x+threadIdx.x;i<n;i+=int64_t(blockDim.x)*gridDim.x)y[i]=__fadd_rn(x[i],b[i%c]);
+}
+__global__ void rounded_score_kernel(float*x,int64_t n,float scale) {
+ for(int64_t i=int64_t(blockIdx.x)*blockDim.x+threadIdx.x;i<n;i+=int64_t(blockDim.x)*gridDim.x)x[i]=load(__float2bfloat16_rn(__fmul_rn(load(__float2bfloat16_rn(x[i])),scale)));
+}
+}
