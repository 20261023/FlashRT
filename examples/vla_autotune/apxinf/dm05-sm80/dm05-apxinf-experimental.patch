+# PUBLIC post-measurement adapter. NOT RUN/imported during packaging.
+"""Summarize saved formal inference outputs/timings. No model execution."""
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument("--reference",type=Path,required=True)
+    parser.add_argument("--core",type=Path,required=True)
+    parser.add_argument("--public",type=Path,required=True)
+    parser.add_argument("--output",type=Path,required=True)
+    args=parser.parse_args()
+    import numpy as np
+    reference=json.loads((args.reference/"result.json").read_text())
+    core=json.loads((args.core/"result.json").read_text())
+    core_quality=json.loads((args.core/"public14-comparison.json").read_text())
+    public=json.loads((args.public/"result.json").read_text())
+    def stats(values):
+        return {"n":len(values),"median_ms":float(np.median(values)),
+                "mean_ms":float(np.mean(values)),"p95_ms":float(np.percentile(values,95))}
+    def quality(cases):
+        comparisons=[v for case in cases for v in case["comparisons"]]
+        return {"passed":all(case["passed"] for case in cases),
+                "worst_relL2":max(v["relL2"] for v in comparisons),
+                "minimum_cosine":min(v["cosine"] for v in comparisons),
+                "max_abs":max(v["max_abs"] for v in comparisons)}
+    author_values=[float(v) for case in reference["cases"]
+                   for v in np.load(args.reference/case["id"]/"samples_ms.npy")]
+    public_stats=stats([v for case in public["cases"] for v in case["samples_ms"]])
+    author_stats=stats(author_values)
+    report={"reference":str(args.reference),"core":str(args.core),"public":str(args.public),
+        "source_revision":reference["source_revision"],
+        "checkpoint_revision":reference["checkpoint_revision"],
+        "job_id":public["job_id"],"native_execution":public["execution"],
+        "author_full_policy":author_stats,"native_full_policy":public_stats,
+        "native_canonical_cpu_to_normalized_cpu":stats([v for case in core["cases"] for v in case["samples_ms"]]),
+        "public_policy_quality":quality(public["cases"]),
+        "canonical_core_public14_quality":quality(core_quality["cases"]),
+        "nominal_full_policy_median_speedup":author_stats["median_ms"]/public_stats["median_ms"],
+        "boundary_difference":public["reference_boundary_difference"],
+        "thresholds":{"relL2_max":0.05,"cosine_min":0.999},
+        "tests_run":False,"extra_reviews":False,"closed_loop_success":"NR",
+        "acceptance_scope":"formal four-case complete-action output and latency only; not a full tested port acceptance"}
+    args.output.write_text(json.dumps(report,indent=2)+"\n")
+    print(json.dumps(report,indent=2))
+
+
+if __name__=="__main__":
+    main()
