+//! Formal full-model inference timing. No tests or synthetic model runs.
+use apxinf_core::{Backend,Device,Tensor};
+use apxinf_model::{dm05::{model::Dm05Model,model_runner::Dm05ModelRunner},ExecutionPolicy,InitialLatent,Observation,PreparedInference,VisionObservation,VlaRequest};
+use std::{path::Path,sync::Arc,time::Instant};
+fn main()->Result<(),Box<dyn std::error::Error>>{
+ if std::env::var_os("SLURM_JOB_ID").is_none()||std::env::var_os("SLURM_STEP_ID").is_none(){return Err("model computation requires allocated Slurm GPU step".into());}
+ let args=std::env::args().collect::<Vec<_>>();if args.len()!=4{return Err("usage: dm05_benchmark CHECKPOINT INPUT_ROOT OUTPUT_ROOT".into());}
+ let out=Path::new(&args[3]);std::fs::create_dir_all(out)?;
+ let backend=Arc::new(apxinf_cuda::CudaBackend::new(0)?);let start=Instant::now();
+ let model=Dm05Model::load(Path::new(&args[1]),Arc::clone(&backend))?;backend.synchronize()?;let eager_math=model.eager_math;
+ let runner=Dm05ModelRunner::new(model);let load_s=start.elapsed().as_secs_f64();let mut records=Vec::new();
+ for case in ["demo-seed0","demo-seed17","state-seed0","prompt-seed0"]{
+  let (mut map,_)=apxinf_loader::safetensors::load_native(&Path::new(&args[2]).join(case).join("inputs.safetensors"))?;
+  let ids=map.remove("input_ids").ok_or("missing input_ids")?.to_f32_vec()?.iter().map(|&v|v as u32).collect::<Vec<_>>();
+  let observation=Observation{vision:VisionObservation::Patches(map.remove("patches").ok_or("missing patches")?),token_ids:ids,state:None,action_mask:Some(map.remove("action_mask").ok_or("missing action_mask")?)};
+  let noise=map.remove("initial_noise").ok_or("missing initial_noise")?;let request=VlaRequest::provided(&observation,&noise);
+  let t=Instant::now();let plan=runner.prepare_request(&request,ExecutionPolicy::RequireGraph)?;backend.synchronize()?;let prepare_s=t.elapsed().as_secs_f64();
+  for _ in 0..5{plan.run(&request)?;backend.synchronize()?;}
+  let mut samples=Vec::new();let mut outputs=Vec::new();
+  for _ in 0..10{backend.synchronize()?;let t=Instant::now();let result=plan.run(&request)?;let values=backend.to_cpu(result.tensor())?.to_f32_vec()?;let ms=t.elapsed().as_secs_f64()*1e3;samples.push(ms);outputs.push(values);}
+  let record=serde_json::json!({"case":case,"samples_ms":samples,"normalized_actions":outputs,"load_s":load_s,"prepare_s":prepare_s,"arena_used_bytes":plan.arena_used(),"execution":"ApxInf-native Rust CUDA whole-model graph","author_math":if eager_math{"eager FP32 linear/latent"}else{"captured suffix BF16 linear/latent"},"boundary":"canonical CPU patches/token IDs/action mask/provided noise -> full normalized CPU actions50x32","tests_run":false,"job_id":std::env::var("SLURM_JOB_ID").ok()});
+  std::fs::write(out.join(format!("{case}.json")),serde_json::to_vec_pretty(&record)?)?;println!("{}",serde_json::json!({"case":case,"prepare_s":prepare_s,"samples_ms":samples}));records.push(record);
+ }
+ std::fs::write(out.join("result.json"),serde_json::to_vec_pretty(&serde_json::json!({"cases":records,"load_s":load_s,"tests_run":false}))?)?;Ok(())
+}
