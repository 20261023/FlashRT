+/// Half-split RoPE: F32 frequencies/positions -> BF16 sin/cos; both products
+/// round to BF16 before the BF16 sum. Q/K normalization is a separate operation.
+pub fn rotary_rounded_bf16(ctx:&(impl CudaLaunchContext+?Sized),input:&Tensor,positions:&Tensor,frequency:&Tensor,out:&mut Tensor)->Result<()> {
+ let d=input.shape().dims();
+ if d.len()!=3 || d[2]<2 || d[2]>256 || d[2]%2!=0 || d[1].checked_mul(d[2]).is_none_or(|v|v>i32::MAX as usize) {return Err(invalid("rounded rotary geometry"));}
+ let x=storage(ctx,input,DType::BF16,d)?; let p=storage(ctx,positions,DType::I32,&[d[0]])?;
+ let f=storage(ctx,frequency,DType::F32,&[d[2]/2])?; let y=storage(ctx,out,DType::BF16,d)?;
+ for v in [&x,&p,&f] {disjoint(&y,v,false)?;}
+ with_launch_device(ctx,|s|unsafe{status::check(abi::apxinf_tensor_rotary_rounded_bf16(x.ptr(),p.ptr(),f.ptr(),y.ptr(),d[0] as i64,d[1] as i64,d[2] as i64,s))})
+}
+/// 2x2 nonoverlapping average pool on contiguous NHWC BF16, F32 accumulation.
+pub fn avg_pool2_bf16(ctx:&(impl CudaLaunchContext+?Sized),input:&Tensor,out:&mut Tensor)->Result<()> {
+ let d=group_dims(input)?; if d[1].checked_mul(d[2]).and_then(|v|v.checked_mul(d[3])).is_none_or(|v|v>i32::MAX as usize){return Err(invalid("pool per-image indexing exceeds i32"));}let x=storage(ctx,input,DType::BF16,&d)?;
+ let y=storage(ctx,out,DType::BF16,&[d[0],d[1]/2,d[2]/2,d[3]])?;disjoint(&y,&x,false)?;
+ with_launch_device(ctx,|s|unsafe{status::check(abi::apxinf_tensor_avg_pool2_bf16(x.ptr(),y.ptr(),d[0] as i64,d[1] as i64,d[2] as i64,d[3] as i64,s))})
+}
+/// Add F32 row-broadcast bias. Exact input/output alias is permitted.
+pub fn bias_f32(ctx:&(impl CudaLaunchContext+?Sized),input:&Tensor,bias:&Tensor,out:&mut Tensor)->Result<()> {
+ let d=input.shape().dims();if d.len()!=2{return Err(invalid("F32 bias expects matrix"));}
+ let x=storage(ctx,input,DType::F32,d)?;let b=storage(ctx,bias,DType::F32,&[d[1]])?;let y=storage(ctx,out,DType::F32,d)?;
+ disjoint(&y,&x,true)?;disjoint(&y,&b,false)?;
+ with_launch_device(ctx,|s|unsafe{status::check(abi::apxinf_tensor_bias_f32(x.ptr(),b.ptr(),y.ptr(),d[0] as i64,d[1] as i64,s))})
+}
+/// In-place score boundaries for eager BF16 attention: BF16(QK), then BF16(scale*QK).
+pub fn round_scaled_scores(ctx:&(impl CudaLaunchContext+?Sized),scores:&mut Tensor,scale:f32)->Result<()> {
+ if !scale.is_finite()||scale<=0. {return Err(invalid("invalid score scale"));}
+ let n=extents(scores.shape().dims())?;let x=storage(ctx,scores,DType::F32,scores.shape().dims())?;
+ with_launch_device(ctx,|s|unsafe{status::check(abi::apxinf_tensor_round_scaled_scores(x.ptr(),n,scale,s))})
+}
 
