+# PUBLIC post-measurement adapter. NOT RUN/imported during packaging.
+"""Requested formal full public policy timing; no tests or extra review runs."""
+import argparse
+import json
+import os
+from pathlib import Path
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--reference", type=Path, required=True)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if not os.environ.get("SLURM_JOB_ID") or not os.environ.get("SLURM_STEP_ID"):
+        raise RuntimeError("model computation requires allocated Slurm GPU step")
+    args.output.mkdir(parents=True, exist_ok=False)
+    import numpy as np
+    import torch
+    from PIL import Image
+    from apxinf.policies import Dm05Policy
+    torch.set_num_threads(2)
+    setup_start = time.perf_counter()
+    policy = Dm05Policy.from_pretrained(args.checkpoint)
+    setup_s = time.perf_counter()-setup_start
+    ref = json.loads((args.reference/"result.json").read_text())
+    images = [Image.open(args.source/"assets/demo/images/episode0"/cam/"0.jpg").convert("RGB")
+              for cam in ("cam_high","cam_left_wrist","cam_right_wrist")]
+    rows = []
+    for case in ref["cases"]:
+        observation = {"prompt":case["prompt"],"state":case["state"],
+                       "images":images,"robot_type":"DOS W1"}
+        noise = torch.load(args.reference/case["id"]/"initial_noise.pt",
+            map_location="cpu",weights_only=True).float().numpy().reshape(50,32)
+        cold = time.perf_counter()
+        for _ in range(5):
+            policy.infer(observation,noise=noise)
+        cold_s = time.perf_counter()-cold
+        samples,outputs = [],[]
+        for _ in range(10):
+            begin = time.perf_counter_ns()
+            output = policy.infer(observation,noise=noise)
+            samples.append((time.perf_counter_ns()-begin)/1e6)
+            outputs.append(np.array(output["actions"],copy=True))
+        a = np.stack(outputs); expected=np.load(args.reference/case["id"]/"actions.npy")
+        comparisons=[]
+        for i,v in enumerate(a):
+            x=v.astype(np.float64).ravel();y=expected[min(i,len(expected)-1)].astype(np.float64).ravel()
+            rel=float(np.linalg.norm(x-y)/max(np.linalg.norm(y),1e-30));cos=float(x@y/max(np.linalg.norm(x)*np.linalg.norm(y),1e-30))
+            comparisons.append({"relL2":rel,"cosine":cos,"max_abs":float(np.max(np.abs(x-y)))})
+        np.save(args.output/f"{case['id']}-actions.npy",a)
+        row={"case":case["id"],"samples_ms":samples,"median_ms":float(np.median(samples)),
+             "warmup_s":cold_s,"comparisons":comparisons,
+             "passed":all(c["relL2"]<=.05 and c["cosine"]>=.999 for c in comparisons) and bool(np.isfinite(a).all())}
+        rows.append(row);print(json.dumps(row),flush=True)
+    report={"execution":"ApxInf-native Rust CUDA whole-model graph; author CPU public transforms",
+            "boundary":"host PIL RGB+state+prompt+exact provided BF16 noise -> complete absolute public14 CPU actions",
+            "reference_boundary_difference":"native uses saved provided noise; author includes CUDA RNG generation",
+            "cases":rows,"setup_s":setup_s,"passed":all(r["passed"] for r in rows),
+            "job_id":os.environ["SLURM_JOB_ID"],"tests_run":False,"closed_loop_success":"NR"}
+    (args.output/"result.json").write_text(json.dumps(report,indent=2)+"\n")
+
+
+if __name__ == "__main__":
+    main()
