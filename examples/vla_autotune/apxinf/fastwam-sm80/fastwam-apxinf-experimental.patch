diff --git a/crates/apxinf-model/src/fastwam/model.rs b/crates/apxinf-model/src/fastwam/model.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3bf1acf71041edc813c03bc4db0e7205afa10222
--- /dev/null
+++ b/crates/apxinf-model/src/fastwam/model.rs
@@ -0,0 +1,409 @@
+//! Native fixed-profile forward equations. Static time conditioning is computed
+//! at construction on GPU; request text KV is computed once per request.
+use apxinf_core::{Backend, DType, Error, Result, Shape, Tensor};
+use apxinf_cuda::{kernels, CudaBackend, CudaContext};
+use apxinf_cuda_new::ops::{spatial_ops, tensor_ops};
+use half::bf16;
+use std::{collections::HashMap, path::Path, sync::Arc};
+
+pub struct FastWamInputs {
+    /// Normalized resized RGB, NHWC[224,448,3], BF16.
+    pub image: Tensor,
+    /// Cached T5[128,4096], BF16. Text encoder is outside this declared seam.
+    pub context: Tensor,
+    pub context_mask: Tensor,
+    pub proprio: Tensor,
+    pub noise: Tensor,
+}
+pub struct FastWamModel {
+    pub backend: Arc<CudaBackend>,
+    pub(crate) weights: HashMap<String, Tensor>,
+    one1024: Tensor,
+    zero1024: Tensor,
+    one3072: Tensor,
+    zero3072: Tensor,
+    video_rope: Tensor,
+    action_rope: Tensor,
+    video_mod: Vec<Tensor>,
+    action_mod: Vec<Vec<Tensor>>,
+    deltas: Vec<f32>,
+    pub(crate) vae_mean: Tensor,
+    pub(crate) vae_inv_std: Tensor,
+}
+pub(crate) fn err(s: impl Into<String>) -> Error {
+    Error::Other(format!("FastWAM native: {}", s.into()))
+}
+pub(crate) fn scratch(ctx: &CudaContext, dtype: DType, dims: &[usize]) -> Result<Tensor> {
+    let n = dims
+        .iter()
+        .try_fold(dtype.size_in_bytes(), |n, &v| n.checked_mul(v))
+        .ok_or_else(|| err("scratch overflow"))?;
+    kernels::scratch_buffer(ctx, n)?
+        .as_tensor(Shape::new(dims.to_vec()), dtype)
+        .map_err(Error::Cuda)
+}
+impl FastWamModel {
+    pub fn load(root: &Path, backend: Arc<CudaBackend>) -> Result<Self> {
+        if backend.context().caps().sm != 80 {
+            return Err(err("this fixed BF16 profile requires SM80"));
+        }
+        let config: serde_json::Value = serde_json::from_slice(
+            &std::fs::read(root.join("config.json")).map_err(|e| err(e.to_string()))?,
+        )
+        .map_err(|e| err(e.to_string()))?;
+        for (key, value) in [
+            ("horizon", 32),
+            ("action_dim", 7),
+            ("proprio_dim", 8),
+            ("text_tokens", 128),
+            ("text_dim", 4096),
+            ("video_layers", 30),
+            ("action_layers", 30),
+        ] {
+            if config[key].as_u64() != Some(value) {
+                return Err(err(format!("unsupported checkpoint {key}")));
+            }
+        }
+        if config["model_type"] != "fastwam" {
+            return Err(err("wrong model_type"));
+        }
+        let (host, _) = apxinf_loader::safetensors::load_native_path(root).map_err(err)?;
+        let mut weights = HashMap::new();
+        for (name, value) in host {
+            if value.dtype() != DType::BF16 {
+                return Err(err(format!("weight {name} is not BF16")));
+            }
+            weights.insert(name, backend.to_device(&value)?);
+        }
+        let upload = |d: Vec<usize>, v: Vec<f32>| {
+            backend.to_device(&Tensor::from_bf16(
+                d,
+                &v.iter().copied().map(bf16::from_f32).collect::<Vec<_>>(),
+            )?)
+        };
+        let one1024 = upload(vec![1024], vec![1.; 1024])?;
+        let zero1024 = upload(vec![1024], vec![0.; 1024])?;
+        let one3072 = upload(vec![3072], vec![1.; 3072])?;
+        let zero3072 = upload(vec![3072], vec![0.; 3072])?;
+        let mut vfreq = Vec::new();
+        for yy in 0..7 {
+            for xx in 0..14 {
+                for (dimension, position) in [(44, 0), (42, yy), (42, xx)] {
+                    for pair in 0..dimension / 2 {
+                        let phase =
+                            position as f64 / 10000f64.powf((pair * 2) as f64 / dimension as f64);
+                        vfreq.extend([phase.cos() as f32, phase.sin() as f32]);
+                    }
+                }
+            }
+        }
+        let video_rope = backend.to_device(&Tensor::from_f32(vec![98, 64, 2], &vfreq)?)?;
+        let mut afreq = Vec::new();
+        for token in 0..32 {
+            for pair in 0..64 {
+                let phase = token as f64 / 10000f64.powf((pair * 2) as f64 / 128.);
+                afreq.extend([phase.cos() as f32, phase.sin() as f32]);
+            }
+        }
+        let action_rope = backend.to_device(&Tensor::from_f32(vec![32, 64, 2], &afreq)?)?;
+        let mean = vec![
+            -0.2289, -0.0052, -0.1323, -0.2339, -0.2799, 0.0174, 0.1838, 0.1557, -0.1382, 0.0542,
+            0.2813, 0.0891, 0.1570, -0.0098, 0.0375, -0.1825, -0.2246, -0.1207, -0.0698, 0.5109,
+            0.2665, -0.2108, -0.2158, 0.2502, -0.2055, -0.0322, 0.1109, 0.1567, -0.0729, 0.0899,
+            -0.2799, -0.1230, -0.0313, -0.1649, 0.0117, 0.0723, -0.2839, -0.2083, -0.0520, 0.3748,
+            0.0152, 0.1957, 0.1433, -0.2944, 0.3573, -0.0548, -0.1681, -0.0667,
+        ];
+        let std = vec![
+            0.4765, 1.0364, 0.4514, 1.1677, 0.5313, 0.4990, 0.4818, 0.5013, 0.8158, 1.0344, 0.5894,
+            1.0901, 0.6885, 0.6165, 0.8454, 0.4978, 0.5759, 0.3523, 0.7135, 0.6804, 0.5833, 1.4146,
+            0.8986, 0.5659, 0.7069, 0.5338, 0.4889, 0.4917, 0.4069, 0.4999, 0.6866, 0.4093, 0.5709,
+            0.6065, 0.6415, 0.4944, 0.5726, 1.2042, 0.5458, 1.6887, 0.3971, 1.0600, 0.3943, 0.5537,
+            0.5444, 0.4089, 0.7468, 0.7744,
+        ];
+        let vae_mean = upload(vec![48], mean)?;
+        let vae_inv_std = upload(vec![48], std.into_iter().map(|x| 1f32 / x).collect())?;
+        let mut model = Self {
+            backend,
+            weights,
+            one1024,
+            zero1024,
+            one3072,
+            zero3072,
+            video_rope,
+            action_rope,
+            video_mod: vec![],
+            action_mod: vec![],
+            deltas: vec![],
+            vae_mean,
+            vae_inv_std,
+        };
+        for (name, shape) in [
+            ("action.action_encoder.weight", vec![7, 1024]),
+            ("action.head.weight", vec![1024, 7]),
+            ("proprio.weight", vec![8, 4096]),
+            ("video.patch_embedding.weight", vec![192, 3072]),
+        ] {
+            if model.w(name)?.shape().dims() != shape {
+                return Err(err(format!("{name} shape mismatch")));
+            }
+        }
+        model.video_mod = model.prepare_time("video", 0.)?;
+        let sigma = |i: usize| {
+            let clock = (20 - i) as f64 / 20.;
+            5. * clock / (1. + 4. * clock)
+        };
+        for step in 0..20 {
+            model.action_mod.push(model.prepare_time(
+                "action",
+                bf16::from_f32((1000. * sigma(step)) as f32).to_f32(),
+            )?);
+            model
+                .deltas
+                .push(bf16::from_f32((sigma(step + 1) - sigma(step)) as f32).to_f32());
+        }
+        model.backend.synchronize()?;
+        Ok(model)
+    }
+    pub(crate) fn w(&self, name: &str) -> Result<&Tensor> {
+        self.weights
+            .get(name)
+            .ok_or_else(|| err(format!("missing weight {name}")))
+    }
+    pub(crate) fn linear(&self, x: &Tensor, name: &str) -> Result<Tensor> {
+        let ctx = self.backend.context();
+        kernels::gemm::bf16_bias(
+            ctx,
+            x,
+            self.w(&format!("{name}.weight"))?,
+            self.w(&format!("{name}.bias"))?,
+        )
+    }
+    fn prepare_time(&self, family: &str, time: f32) -> Result<Vec<Tensor>> {
+        let mut v = Vec::new();
+        for i in 0..128 {
+            let a = time as f64 / 10000f64.powf(i as f64 / 128.);
+            v.push(bf16::from_f32(a.cos() as f32));
+        }
+        for i in 0..128 {
+            let a = time as f64 / 10000f64.powf(i as f64 / 128.);
+            v.push(bf16::from_f32(a.sin() as f32));
+        }
+        let t = self
+            .backend
+            .to_device(&Tensor::from_bf16(vec![1, 256], &v)?)?;
+        let t = self.linear(&t, &format!("{family}.time_embedding.0"))?;
+        let t = kernels::activation::silu(self.backend.context(), &t)?;
+        let t = self.linear(&t, &format!("{family}.time_embedding.2"))?;
+        let t = kernels::activation::silu(self.backend.context(), &t)?;
+        let t = self.linear(&t, &format!("{family}.time_projection.1"))?;
+        let d = if family == "video" { 3072 } else { 1024 };
+        (0..30)
+            .map(|layer| {
+                kernels::elementwise::add(
+                    self.backend.context(),
+                    &t.reshape(vec![6, d])?,
+                    &self
+                        .w(&format!("{family}.blocks.{layer}.modulation"))?
+                        .reshape(vec![6, d])?,
+                )
+            })
+            .collect()
+    }
+    fn norm(&self, x: &Tensor, affine: Option<&str>) -> Result<Tensor> {
+        let d = x.shape().dims()[1];
+        let (w, b) = match affine {
+            Some(name) => (
+                self.w(&format!("{name}.weight"))?,
+                self.w(&format!("{name}.bias"))?,
+            ),
+            None => {
+                if d == 3072 {
+                    (&self.one3072, &self.zero3072)
+                } else {
+                    (&self.one1024, &self.zero1024)
+                }
+            }
+        };
+        let mut out = scratch(self.backend.context(), DType::BF16, x.shape().dims())?;
+        tensor_ops::layer_norm_welford_bf16(self.backend.context(), x, w, b, &mut out, 1e-6)?;
+        Ok(out)
+    }
+    fn rms(&self, x: &Tensor, name: &str) -> Result<Tensor> {
+        let mut out = scratch(self.backend.context(), DType::BF16, x.shape().dims())?;
+        tensor_ops::rms_bf16_rounded(self.backend.context(), x, self.w(name)?, &mut out, 1e-6)?;
+        Ok(out)
+    }
+    fn mod_row(&self, mods: &Tensor, index: usize) -> Result<Tensor> {
+        let d = mods.shape().dims()[1];
+        kernels::elementwise::contiguous_rows(self.backend.context(), mods, index, 1)?
+            .reshape(vec![d])
+    }
+    fn affine(&self, x: &Tensor, a: &Tensor, b: &Tensor, mode: u32) -> Result<Tensor> {
+        let mut out = scratch(self.backend.context(), DType::BF16, x.shape().dims())?;
+        spatial_ops::affine_bf16(self.backend.context(), x, a, b, &mut out, mode)?;
+        Ok(out)
+    }
+    fn text(&self, context: &Tensor, family: &str) -> Result<Tensor> {
+        let x = self.linear(context, &format!("{family}.text_embedding.0"))?;
+        let x = kernels::activation::gelu_tanh(self.backend.context(), &x)?;
+        self.linear(&x, &format!("{family}.text_embedding.2"))
+    }
+    fn cross_kv(&self, context: &Tensor, name: &str) -> Result<(Tensor, Tensor)> {
+        let k = self.linear(context, &format!("{name}.cross_attn.k"))?;
+        let k = self.rms(&k, &format!("{name}.cross_attn.norm_k.weight"))?;
+        let v = self.linear(context, &format!("{name}.cross_attn.v"))?;
+        Ok((k, v))
+    }
+    pub(crate) fn attention(
+        &self,
+        q: &Tensor,
+        k: &Tensor,
+        v: &Tensor,
+        heads: usize,
+        dim: usize,
+        mask: Option<&Tensor>,
+    ) -> Result<Tensor> {
+        let nq = q.numel() / (heads * dim);
+        let nk = k.numel() / (heads * dim);
+        let q = q.reshape(vec![nq, heads, dim])?;
+        let k = k.reshape(vec![nk, heads, dim])?;
+        let v = v.reshape(vec![nk, heads, dim])?;
+        // Reuse maintained FA2 for the homogeneous video self-attention. The
+        // masked cross and heterogeneous action attention use a safe baseline.
+        if mask.is_none() && nq == nk && dim <= 256 {
+            return kernels::attention::mha_bf16(self.backend.context(), &q, &k, &v, nq)?
+                .reshape(vec![nq, heads * dim]);
+        }
+        let mut out = scratch(self.backend.context(), DType::BF16, &[nq, heads, dim])?;
+        spatial_ops::masked_attention_bf16(self.backend.context(), &q, &k, &v, mask, &mut out)?;
+        out.reshape(vec![nq, heads * dim])
+    }
+    fn qkv(
+        &self,
+        x: &Tensor,
+        name: &str,
+        mods: &Tensor,
+        rope: &Tensor,
+    ) -> Result<(Tensor, Tensor, Tensor)> {
+        let x = self.norm(x, None)?;
+        let x = self.affine(&x, &self.mod_row(mods, 1)?, &self.mod_row(mods, 0)?, 0)?;
+        let q = self.rms(
+            &self.linear(&x, &format!("{name}.self_attn.q"))?,
+            &format!("{name}.self_attn.norm_q.weight"),
+        )?;
+        let k = self.rms(
+            &self.linear(&x, &format!("{name}.self_attn.k"))?,
+            &format!("{name}.self_attn.norm_k.weight"),
+        )?;
+        let v = self.linear(&x, &format!("{name}.self_attn.v"))?;
+        let rows = x.shape().dims()[0];
+        let mut qr = scratch(self.backend.context(), DType::BF16, &[rows, 24, 128])?;
+        let mut kr = scratch(self.backend.context(), DType::BF16, &[rows, 24, 128])?;
+        spatial_ops::adjacent_rope_bf16(
+            self.backend.context(),
+            &q.reshape(vec![rows, 24, 128])?,
+            rope,
+            &mut qr,
+        )?;
+        spatial_ops::adjacent_rope_bf16(
+            self.backend.context(),
+            &k.reshape(vec![rows, 24, 128])?,
+            rope,
+            &mut kr,
+        )?;
+        Ok((
+            qr.reshape(vec![rows, 3072])?,
+            kr.reshape(vec![rows, 3072])?,
+            v,
+        ))
+    }
+    fn post(
+        &self,
+        x: &Tensor,
+        mixed: &Tensor,
+        name: &str,
+        mods: &Tensor,
+        cross: &(Tensor, Tensor),
+        mask: &Tensor,
+    ) -> Result<Tensor> {
+        let ctx = self.backend.context();
+        let projected = self.linear(mixed, &format!("{name}.self_attn.o"))?;
+        let x = self.affine(x, &self.mod_row(mods, 2)?, &projected, 1)?;
+        let norm = self.norm(&x, Some(&format!("{name}.norm3")))?;
+        let q = self.rms(
+            &self.linear(&norm, &format!("{name}.cross_attn.q"))?,
+            &format!("{name}.cross_attn.norm_q.weight"),
+        )?;
+        let attended = self.attention(&q, &cross.0, &cross.1, 24, 128, Some(mask))?;
+        let x = kernels::elementwise::add(
+            ctx,
+            &x,
+            &self.linear(&attended, &format!("{name}.cross_attn.o"))?,
+        )?;
+        let norm = self.norm(&x, None)?;
+        let norm = self.affine(&norm, &self.mod_row(mods, 4)?, &self.mod_row(mods, 3)?, 0)?;
+        let ff = self.linear(&norm, &format!("{name}.ffn.0"))?;
+        let ff = kernels::activation::gelu_tanh(ctx, &ff)?;
+        let ff = self.linear(&ff, &format!("{name}.ffn.2"))?;
+        self.affine(&x, &self.mod_row(mods, 5)?, &ff, 1)
+    }
+    /// Complete native image -> VAE38 -> VideoDiT30 -> ActionDiT30 x20 path.
+    pub fn forward(&self, input: &FastWamInputs) -> Result<Tensor> {
+        let ctx = self.backend.context();
+        for (t, s, d) in [
+            (&input.image, vec![224, 448, 3], DType::BF16),
+            (&input.context, vec![128, 4096], DType::BF16),
+            (&input.context_mask, vec![129], DType::I8),
+            (&input.proprio, vec![1, 8], DType::BF16),
+            (&input.noise, vec![32, 7], DType::BF16),
+        ] {
+            if t.shape().dims() != s || t.dtype() != d || t.device() != self.backend.device() {
+                return Err(err("fixed input profile mismatch"));
+            }
+        }
+        let latents = self.vision(&input.image)?;
+        let mut patches = scratch(ctx, DType::BF16, &[98, 192])?;
+        spatial_ops::im2col_bf16(ctx, &latents, &mut patches, [2, 2], [2, 2], [0, 0], [7, 14])?;
+        let mut video = self.linear(&patches, "video.patch_embedding")?;
+        let proprio = self.linear(&input.proprio, "proprio")?;
+        let context = kernels::elementwise::concat_rows_bf16(ctx, &input.context, &proprio)?;
+        let vctx = self.text(&context, "video")?;
+        let actx = self.text(&context, "action")?;
+        let mut vcache = Vec::new();
+        let mut acache = Vec::new();
+        for layer in 0..30 {
+            let name = format!("video.blocks.{layer}");
+            let mods = &self.video_mod[layer];
+            let cross = self.cross_kv(&vctx, &name)?;
+            let (q, k, v) = self.qkv(&video, &name, mods, &self.video_rope)?;
+            let attended = self.attention(&q, &k, &v, 24, 128, None)?;
+            video = self.post(&video, &attended, &name, mods, &cross, &input.context_mask)?;
+            vcache.push((k, v));
+            acache.push(self.cross_kv(&actx, &format!("action.blocks.{layer}"))?);
+        }
+        let mut state = input.noise.clone();
+        for step in 0..20 {
+            let mut x = self.linear(&state, "action.action_encoder")?;
+            for layer in 0..30 {
+                let name = format!("action.blocks.{layer}");
+                let mods = &self.action_mod[step][layer];
+                let (q, k, v) = self.qkv(&x, &name, mods, &self.action_rope)?;
+                let k = kernels::elementwise::concat_rows_bf16(ctx, &vcache[layer].0, &k)?;
+                let v = kernels::elementwise::concat_rows_bf16(ctx, &vcache[layer].1, &v)?;
+                let attended = self.attention(&q, &k, &v, 24, 128, None)?;
+                x = self.post(
+                    &x,
+                    &attended,
+                    &name,
+                    mods,
+                    &acache[layer],
+                    &input.context_mask,
+                )?;
+            }
+            let velocity = self.linear(&x, "action.head")?;
+            let delta = kernels::elementwise::scale(ctx, &velocity, self.deltas[step])?;
+            state = kernels::elementwise::add(ctx, &state, &delta)?;
+        }
+        Ok(state)
+    }
+}
diff --git a/crates/apxinf-model/src/fastwam/runner.rs b/crates/apxinf-model/src/fastwam/runner.rs
new file mode 100644
index 0000000000000000000000000000000000000000..02fca001b6e78976ab1e6838b3e167b561d49ac9
--- /dev/null
+++ b/crates/apxinf-model/src/fastwam/runner.rs
@@ -0,0 +1,286 @@
+//! Stable input ownership and whole-model graph, including all20 Euler steps.
+//! Request operations are serialized. Output aliases the last run's buffer.
+use super::model::{err, FastWamInputs, FastWamModel};
+use crate::vla::*;
+use apxinf_core::{Backend, DType, Device, Graph, Result, Tensor};
+use apxinf_cuda::{kernels, transfers, tuning};
+use half::bf16;
+use std::{cell::RefCell, rc::Rc};
+
+pub struct FastWamRunner {
+    pub model: Rc<FastWamModel>,
+    plan: RefCell<Option<FastWamPrepared>>,
+}
+pub struct FastWamPrepared {
+    // Field order: destroy graph before storage and retained model.
+    graph: Option<Box<dyn Graph>>,
+    output: Tensor,
+    arena: kernels::GraphWorkspace,
+    input: FastWamInputs,
+    model: Rc<FastWamModel>,
+    spec: InferenceSpec,
+}
+fn host_bf(t: &Tensor, shape: &[usize]) -> Result<Tensor> {
+    if t.device() != Device::Cpu || t.numel() != shape.iter().product::<usize>() {
+        return Err(err("host input size/device mismatch"));
+    }
+    if !matches!(t.dtype(), DType::F32 | DType::BF16) {
+        return Err(err("host floating inputs require FP32 or BF16"));
+    }
+    if t.dtype() == DType::BF16 {
+        return t.reshape(shape.to_vec());
+    }
+    let v = t.to_f32_vec()?;
+    if v.iter().any(|x| !x.is_finite()) {
+        return Err(err("nonfinite host input"));
+    }
+    Tensor::from_bf16(
+        shape.to_vec(),
+        &v.into_iter().map(bf16::from_f32).collect::<Vec<_>>(),
+    )
+}
+impl FastWamInputs {
+    pub fn from_host(
+        image: &Tensor,
+        context: &Tensor,
+        proprio: &Tensor,
+        noise: &Tensor,
+        mask: &[u8],
+    ) -> Result<Self> {
+        if !matches!(image.shape().dims(), [224, 448, 3] | [100352, 3])
+            || context.shape().dims() != [128, 4096]
+            || proprio.numel() != 8
+            || noise.numel() != 224
+            || mask.len() != 128
+            || mask.iter().any(|&x| x > 1)
+        {
+            return Err(err(
+                "LIBERO image224x448x3/context128x4096/proprio8/noise32x7/mask128 required",
+            ));
+        }
+        let mut mask = mask.iter().map(|&x| x as i8).collect::<Vec<_>>();
+        mask.push(1);
+        Ok(Self {
+            image: host_bf(image, &[224, 448, 3])?,
+            context: host_bf(context, &[128, 4096])?,
+            proprio: host_bf(proprio, &[1, 8])?,
+            noise: host_bf(noise, &[32, 7])?,
+            context_mask: Tensor::from_i8(vec![129], &mask)?,
+        })
+    }
+}
+impl FastWamRunner {
+    pub fn new(model: FastWamModel) -> Self {
+        Self {
+            model: Rc::new(model),
+            plan: RefCell::new(None),
+        }
+    }
+    pub fn prepare_native(&self, host: &FastWamInputs, graph: bool) -> Result<FastWamPrepared> {
+        let backend = &self.model.backend;
+        let input = FastWamInputs {
+            image: backend.to_device(&host.image)?,
+            context: backend.to_device(&host.context)?,
+            context_mask: backend.to_device(&host.context_mask)?,
+            proprio: backend.to_device(&host.proprio)?,
+            noise: backend.to_device(&host.noise)?,
+        };
+        // Monotonic graph arena retains all transient outputs. Setup-only;
+        // never allocates in replay. Bounded profile, 12GiB capacity.
+        let arena = kernels::GraphWorkspace::new(12usize << 30, backend.device_id())?;
+        let eager = tuning::without_autotune(|| {
+            kernels::prepare_with_workspace(&arena, || self.model.forward(&input))
+        })?;
+        backend.synchronize()?;
+        let (captured, output) = if graph {
+            let (g, o) = backend.capture_graph(|| {
+                tuning::without_autotune(|| {
+                    kernels::with_workspace(&arena, || self.model.forward(&input))
+                })
+            })?;
+            (Some(g), o)
+        } else {
+            (None, eager)
+        };
+        backend.synchronize()?;
+        eprintln!(
+            "FastWAM native prepare graph={} arena_used={} capacity={}",
+            graph,
+            arena.used(),
+            arena.capacity()
+        );
+        Ok(FastWamPrepared {
+            graph: captured,
+            output,
+            arena,
+            input,
+            model: Rc::clone(&self.model),
+            spec: InferenceSpec {
+                token_count: 128,
+                image_layout: None,
+            },
+        })
+    }
+    fn bind_request(request: &VlaRequest<'_>) -> Result<FastWamInputs> {
+        let observation = request.observation;
+        if observation.token_ids.len() != 128
+            || observation.action_mask.is_some()
+            || request.metadata.planning.is_some()
+        {
+            return Err(err(
+                "fixed cached-T5 profile requires128 slots, no mask/step override",
+            ));
+        }
+        let image = match &observation.vision {
+            VisionObservation::Patches(t) => t,
+            _ => return Err(err("normalized NHWC image tensor required")),
+        };
+        let context = request
+            .metadata
+            .language_features
+            .ok_or_else(|| err("cached language_features[128,4096] required"))?;
+        let proprio = observation
+            .state
+            .as_ref()
+            .ok_or_else(|| err("proprio8 required"))?;
+        let noise = match request.initial_latent {
+            InitialLatent::Provided(t) => t,
+            _ => {
+                return Err(err(
+                    "fixed profile currently requires caller-supplied exact noise32x7",
+                ))
+            }
+        };
+        let mask = request
+            .metadata
+            .attention_mask
+            .ok_or_else(|| err("cachedT5 attention mask128 required"))?;
+        FastWamInputs::from_host(image, context, proprio, noise, mask)
+    }
+    pub fn infer_native(&self, host: &FastWamInputs) -> Result<Tensor> {
+        let mut plan = self
+            .plan
+            .try_borrow_mut()
+            .map_err(|_| err("runs must be serialized"))?;
+        if plan.is_none() {
+            *plan = Some(self.prepare_native(host, true)?);
+        }
+        let plan = plan.as_mut().ok_or_else(|| err("plan missing"))?;
+        plan.update(host)?;
+        plan.replay()
+    }
+}
+impl FastWamPrepared {
+    pub fn arena_used(&self) -> usize {
+        self.arena.used()
+    }
+    pub fn update(&mut self, host: &FastWamInputs) -> Result<()> {
+        self.model.backend.synchronize()?;
+        for (src, dst) in [
+            (&host.image, &self.input.image),
+            (&host.context, &self.input.context),
+            (&host.context_mask, &self.input.context_mask),
+            (&host.proprio, &self.input.proprio),
+            (&host.noise, &self.input.noise),
+        ] {
+            transfers::copy_cpu_to_cuda(src, dst)?;
+        }
+        Ok(())
+    }
+    pub fn replay(&self) -> Result<Tensor> {
+        if let Some(g) = &self.graph {
+            g.replay()?;
+            Ok(self.output.clone())
+        } else {
+            tuning::without_autotune(|| {
+                kernels::with_workspace(&self.arena, || self.model.forward(&self.input))
+            })
+        }
+    }
+}
+impl Drop for FastWamPrepared {
+    fn drop(&mut self) {
+        let _ = self.model.backend.synchronize();
+    }
+}
+struct PublicPrepared {
+    inner: RefCell<FastWamPrepared>,
+    spec: InferenceSpec,
+}
+impl PreparedInference for PublicPrepared {
+    fn spec(&self) -> &InferenceSpec {
+        &self.spec
+    }
+    fn status(&self) -> PreparationStatus {
+        PreparationStatus::Ready {
+            mode: if self.inner.borrow().graph.is_some() {
+                ExecutionMode::Graph
+            } else {
+                ExecutionMode::Eager
+            },
+            fallback_reason: None,
+        }
+    }
+    fn run(&self, request: &VlaRequest<'_>) -> Result<Action> {
+        let host = FastWamRunner::bind_request(request)?;
+        let mut p = self
+            .inner
+            .try_borrow_mut()
+            .map_err(|_| err("prepared calls must be serialized"))?;
+        p.update(&host)?;
+        p.replay().map(Action::new)
+    }
+}
+impl VlaRuntime for FastWamRunner {
+    fn model_variant(&self) -> Option<&'static str> {
+        Some("bf16")
+    }
+    fn contract(&self) -> VlaContract {
+        VlaContract {
+            action_shape: [32, 7],
+            patch_shape: [224 * 448, 3],
+            max_token_len: 128,
+            num_views: 1,
+            image_size: 224,
+            patch_size: 1,
+            accepts_rgb_u8: false,
+        }
+    }
+    fn infer(&self, r: &VlaRequest<'_>) -> Result<Action> {
+        self.infer_native(&Self::bind_request(r)?).map(Action::new)
+    }
+    fn prepare(&self, _s: &InferenceSpec) -> Result<Box<dyn PreparedInference>> {
+        Err(err("use prepare_for with actual cached language input"))
+    }
+    fn prepare_for(
+        &self,
+        r: &VlaRequest<'_>,
+        policy: ExecutionPolicy,
+    ) -> Result<Box<dyn PreparedInference>> {
+        let host = Self::bind_request(r)?;
+        let inner = self.prepare_native(&host, policy != ExecutionPolicy::Eager)?;
+        Ok(Box::new(PublicPrepared {
+            inner: RefCell::new(inner),
+            spec: r.observation.inference_spec(),
+        }))
+    }
+    fn clear_prepared(&self) -> Result<()> {
+        self.model.backend.synchronize()?;
+        self.plan
+            .try_borrow_mut()
+            .map_err(|_| err("runner in use"))?
+            .take();
+        Ok(())
+    }
+    fn execution_mode(&self) -> &'static str {
+        if self.plan.borrow().is_some() {
+            "whole-model-graph"
+        } else {
+            "unprepared"
+        }
+    }
+    fn infer_host_f32(&self, r: &VlaRequest<'_>) -> Result<Vec<f32>> {
+        let out = self.infer(r)?;
+        self.model.backend.to_cpu(out.tensor())?.to_f32_vec()
+    }
+}
diff --git a/crates/apxinf-model/src/fastwam/vision.rs b/crates/apxinf-model/src/fastwam/vision.rs
new file mode 100644
index 0000000000000000000000000000000000000000..289f9d2ae90977bbe83a585a3a0f26eac57dc019
--- /dev/null
+++ b/crates/apxinf-model/src/fastwam/vision.rs
@@ -0,0 +1,147 @@
+//! WanVideoVAE38 encoder at its explicitly restricted single-frame profile.
+//! Zero-history CausalConv3d slices are transformed once at checkpoint export;
+//! first-chunk temporal downsamplers intentionally bypass time_conv as upstream.
+use super::model::{err, scratch, FastWamModel};
+use apxinf_core::{DType, Result, Tensor};
+use apxinf_cuda::kernels;
+use apxinf_cuda_new::ops::spatial_ops;
+
+impl FastWamModel {
+    fn conv(
+        &self,
+        x: &Tensor,
+        name: &str,
+        k: usize,
+        stride: usize,
+        padding: usize,
+        oh: usize,
+        ow: usize,
+    ) -> Result<Tensor> {
+        let d = x.shape().dims();
+        if d.len() != 3 {
+            return Err(err("VAE input must be NHWC"));
+        }
+        let mut col = scratch(
+            self.backend.context(),
+            DType::BF16,
+            &[oh * ow, k * k * d[2]],
+        )?;
+        spatial_ops::im2col_bf16(
+            self.backend.context(),
+            x,
+            &mut col,
+            [k, k],
+            [stride, stride],
+            [padding, padding],
+            [oh, ow],
+        )?;
+        // Standalone convolution rounds accumulation before its BF16 bias add.
+        let mat = kernels::gemm::bf16(
+            self.backend.context(),
+            &col,
+            self.w(&format!("{name}.weight"))?,
+        )?;
+        let mat = kernels::elementwise::bias_bf16(
+            self.backend.context(),
+            &mat,
+            Some(self.w(&format!("{name}.bias"))?),
+        )?;
+        let c = mat.shape().dims()[1];
+        mat.reshape(vec![oh, ow, c])
+    }
+    fn vae_norm(&self, x: &Tensor, name: &str) -> Result<Tensor> {
+        let d = x.shape().dims();
+        let rows = d[0] * d[1];
+        let c = d[2];
+        let mut out = scratch(self.backend.context(), DType::BF16, &[rows, c])?;
+        spatial_ops::l2_channel_bf16(
+            self.backend.context(),
+            &x.reshape(vec![rows, c])?,
+            self.w(name)?,
+            &mut out,
+        )?;
+        out.reshape(d.to_vec())
+    }
+    fn residual(&self, x: &Tensor, name: &str) -> Result<Tensor> {
+        let d = x.shape().dims();
+        let (h, w) = (d[0], d[1]);
+        let shortcut = if self
+            .weights
+            .contains_key(&format!("{name}.shortcut.weight"))
+        {
+            self.conv(x, &format!("{name}.shortcut"), 1, 1, 0, h, w)?
+        } else {
+            x.clone()
+        };
+        let y = self.vae_norm(x, &format!("{name}.residual.0.gamma"))?;
+        let y = kernels::activation::silu(self.backend.context(), &y)?;
+        let y = self.conv(&y, &format!("{name}.residual.2"), 3, 1, 1, h, w)?;
+        let y = self.vae_norm(&y, &format!("{name}.residual.3.gamma"))?;
+        let y = kernels::activation::silu(self.backend.context(), &y)?;
+        let y = self.conv(&y, &format!("{name}.residual.6"), 3, 1, 1, h, w)?;
+        kernels::elementwise::add(self.backend.context(), &y, &shortcut)
+    }
+    pub(crate) fn vision(&self, image: &Tensor) -> Result<Tensor> {
+        let ctx = self.backend.context();
+        let mut x = scratch(ctx, DType::BF16, &[112, 224, 12])?;
+        spatial_ops::patchify_bf16(ctx, image, &mut x, 2)?;
+        x = self.conv(&x, "vae.encoder.conv1", 3, 1, 1, 112, 224)?;
+        for stage in 0..4 {
+            let original = x.clone();
+            let (h, w) = (x.shape().dims()[0], x.shape().dims()[1]);
+            for block in 0..2 {
+                x = self.residual(
+                    &x,
+                    &format!("vae.encoder.downsamples.{stage}.downsamples.{block}"),
+                )?;
+            }
+            let co = x.shape().dims()[2];
+            let fs = if stage < 3 { 2 } else { 1 };
+            let ft = if stage == 1 || stage == 2 { 2 } else { 1 };
+            if stage < 3 {
+                x = self.conv(
+                    &x,
+                    &format!("vae.encoder.downsamples.{stage}.downsamples.2.resample.1"),
+                    3,
+                    2,
+                    0,
+                    h / 2,
+                    w / 2,
+                )?;
+            }
+            let mut shortcut = scratch(ctx, DType::BF16, &[h / fs, w / fs, co])?;
+            spatial_ops::avg_first_bf16(ctx, &original, &mut shortcut, co, fs, ft)?;
+            x = kernels::elementwise::add(ctx, &x, &shortcut)?;
+        }
+        x = self.residual(&x, "vae.encoder.middle.0")?;
+        let residual = x.clone();
+        let normalized = self.vae_norm(&x, "vae.encoder.middle.1.norm.gamma")?;
+        let qkv = self
+            .conv(&normalized, "vae.encoder.middle.1.to_qkv", 1, 1, 0, 14, 28)?
+            .reshape(vec![392, 1920])?;
+        let qkv = kernels::attention::split_qkv_bias_bf16(ctx, &qkv, None, 1, 640)?;
+        let attended = self
+            .attention(&qkv.q, &qkv.k, &qkv.v, 1, 640, None)?
+            .reshape(vec![14, 28, 640])?;
+        let projected = self.conv(&attended, "vae.encoder.middle.1.proj", 1, 1, 0, 14, 28)?;
+        x = kernels::elementwise::add(ctx, &residual, &projected)?;
+        x = self.residual(&x, "vae.encoder.middle.2")?;
+        x = self.vae_norm(&x, "vae.encoder.head.0.gamma")?;
+        x = kernels::activation::silu(ctx, &x)?;
+        x = self.conv(&x, "vae.encoder.head.2", 3, 1, 1, 14, 28)?;
+        x = self.conv(&x, "vae.conv1", 1, 1, 0, 14, 28)?;
+        // Mu/logvar chunk is along channels. Conv1 output is NHWC[14,28,96].
+        let out =
+            kernels::elementwise::contiguous_columns_bf16(ctx, &x.reshape(vec![392, 96])?, 0, 48)?;
+        let mut normalized = scratch(ctx, DType::BF16, &[392, 48])?;
+        spatial_ops::affine_bf16(
+            ctx,
+            &out,
+            &self.vae_mean,
+            &self.vae_inv_std,
+            &mut normalized,
+            2,
+        )?;
+        normalized.reshape(vec![14, 28, 48])
+    }
+}
