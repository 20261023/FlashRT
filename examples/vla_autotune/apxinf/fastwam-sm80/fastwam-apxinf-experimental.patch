+//! Model-neutral fixed BF16 spatial/tensor primitives. Caller-owned outputs,
+//! single asynchronous implementation, no tuning, allocation or host readback.
+//! Experimental: numerical/operator tests deliberately not run under task waiver.
+use crate::context::with_launch_device;
+use crate::ffi::abi::status;
+use crate::ops::gemm::contracts::tensor_storage;
+use crate::{CudaBuffer, CudaLaunchContext};
+use apxinf_core::{DType, Error, Result, Tensor};
+use std::ffi::c_void;
+
+unsafe extern "C" {
