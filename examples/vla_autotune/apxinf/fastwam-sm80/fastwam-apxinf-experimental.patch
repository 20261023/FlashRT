 //! Elementwise operator contracts.
+
+/// Copy a contiguous column interval from a BF16 matrix into packed rows.
+/// Uses stream-ordered D2D copies and the graph workspace; no host readback.
+pub fn contiguous_columns_bf16(ctx:&crate::CudaContext,input:&apxinf_core::Tensor,start:usize,count:usize)->apxinf_core::Result<apxinf_core::Tensor>{
+    let dims=input.shape().dims();
+    if input.dtype()!=apxinf_core::DType::BF16||input.device()!=apxinf_core::Device::Cuda(ctx.device_id())||dims.len()!=2||dims[0]==0||count==0||start.checked_add(count).is_none_or(|end|end>dims[1]){
+        return Err(apxinf_core::Error::Other("BF16 column slice contract mismatch".into()));
+    }
+    let bytes=dims[0].checked_mul(count).and_then(|n|n.checked_mul(2)).ok_or_else(||apxinf_core::Error::Other("column slice overflow".into()))?;
+    let output=crate::workspace::output_buffer(ctx,bytes)?;
+    let source=crate::CudaBuffer::from_tensor(input).map_err(apxinf_core::Error::Cuda)?;
+    let source=source.view(start*2,source.len()-start*2).map_err(apxinf_core::Error::Cuda)?;
+    let source=source.as_tensor(apxinf_core::Shape::new(vec![source.len()/2]),apxinf_core::DType::BF16).map_err(apxinf_core::Error::Cuda)?;
+    crate::transfers::copy_tensor_2d_to_buffer(ctx,&source,&output,0,count*2,dims[1]*2,count*2,dims[0])?;
+    output.as_tensor(apxinf_core::Shape::new(vec![dims[0],count]),apxinf_core::DType::BF16).map_err(apxinf_core::Error::Cuda)
+}
 
 use apxinf_core::{DType, Device, Error, Result, Shape, Tensor};
 
