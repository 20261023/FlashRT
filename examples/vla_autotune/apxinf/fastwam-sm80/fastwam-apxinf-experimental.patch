+#!/usr/bin/env bash
+# PUBLIC parameterized copy of the private task build commands.
+# Not newly built/run. Build only: no tests, imports, model execution or jobs.
+set -euo pipefail
+root="${FASTWAM_TASK_ROOT:?set an owned task/output directory}"
+source_root="${APXINF_SOURCE_ROOT:?set the patched foundation source directory}"
+toolchain_cargo="${APXINF_TOOLCHAIN_CARGO_HOME:?set the approved existing cargo toolchain/cache directory}"
+export RUSTUP_HOME="${APXINF_TOOLCHAIN_RUSTUP_HOME:?set the approved existing rustup directory}"
+source "${APXINF_MODULE_INIT:-/usr/share/modules/init/bash}"
+module load cuda/12.8 gcc/11.4.0 cmake/3.31.12
+export CARGO_HOME="$root/cargo-home"
+mkdir -p "$CARGO_HOME"
+if [ ! -e "$CARGO_HOME/registry" ]; then ln -s "$toolchain_cargo/registry" "$CARGO_HOME/registry"; fi
+if [ -d "$toolchain_cargo/git" ] && [ ! -e "$CARGO_HOME/git" ]; then ln -s "$toolchain_cargo/git" "$CARGO_HOME/git"; fi
+export RUSTUP_TOOLCHAIN=1.95.0-x86_64-unknown-linux-gnu
+export PATH="$toolchain_cargo/bin:$PATH"
+export CARGO_TARGET_DIR="$root/target"
+export CARGO_BUILD_JOBS=8 APXINF_CUDA_ARCH=sm_80
+# The measured build supplied matching read-only foundation build directories.
+# Caller may explicitly set APXINF_FOUNDATION_CUDA_BUILD and
+# APXINF_FOUNDATION_CUDA_NEW_BUILD; no private paths are discovered or embedded.
+# Unset inputs select full native source compilation, not the recorded build.
+export LIBRARY_PATH="$CUDA_PATH/lib64/stubs${LIBRARY_PATH:+:$LIBRARY_PATH}"
+export TMPDIR="$root/tmp"
+mkdir -p "$TMPDIR"
+cd "$source_root"
+if [ "${1:-model}" = python ]; then
+    export PYO3_PYTHON="${APPROVED_NATIVE_PYTHON:?set the approved existing Python3.11 executable}"
+    cargo build --release --offline --locked -p apxinf-py --features cuda,extension-module
+    mkdir -p "$root/py-native"
+    cp "$CARGO_TARGET_DIR/release/libapxinf_py.so" "$root/py-native/apxinf_py.so"
+else
+    cargo build --release --offline --locked -p apxinf-model --features cuda --example fastwam_bench
+fi
