+        oh: i32,
+        ow: i32,
+        s: *mut c_void,
+    ) -> i32;
+    fn apxinf_spatial_patchify(
+        x: *const c_void,
+        y: *mut c_void,
+        h: i32,
+        w: i32,
+        c: i32,
+        p: i32,
+        s: *mut c_void,
+    ) -> i32;
+    fn apxinf_spatial_avg_first(
+        x: *const c_void,
+        y: *mut c_void,
+        h: i32,
+        w: i32,
+        ci: i32,
+        co: i32,
+        fs: i32,
+        ft: i32,
+        s: *mut c_void,
+    ) -> i32;
+    fn apxinf_spatial_l2(
+        x: *const c_void,
+        g: *const c_void,
+        y: *mut c_void,
+        r: i32,
+        c: i32,
+        s: *mut c_void,
+    ) -> i32;
+    fn apxinf_spatial_rope(
+        x: *const c_void,
+        f: *const c_void,
+        y: *mut c_void,
+        t: i32,
+        h: i32,
+        d: i32,
+        s: *mut c_void,
+    ) -> i32;
+    fn apxinf_spatial_affine(
+        x: *const c_void,
+        a: *const c_void,
+        b: *const c_void,
+        y: *mut c_void,
+        r: i32,
+        c: i32,
