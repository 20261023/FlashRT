+//! Author semantics: FastWAM 7faa71108368fbb3b6885649f112af607427a2d4.
+//! No Torch, TensorRT, or other model-family execution dependencies.
+pub(crate) mod load;
+pub mod model;
+pub mod runner;
+mod vision;
