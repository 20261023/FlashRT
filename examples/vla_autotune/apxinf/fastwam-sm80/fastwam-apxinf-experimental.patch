+        y: *mut c_void,
+        nq: i32,
+        nk: i32,
+        h: i32,
+        d: i32,
+        s: *mut c_void,
+    ) -> i32;
+}
+fn invalid(s: &str) -> Error {
+    Error::Other(format!("spatial tensor primitive: {s}"))
+}
+fn dims(t: &Tensor) -> Result<Vec<usize>> {
+    let d = t.shape().dims();
+    if d.is_empty()
+        || d.iter().any(|&x| x == 0 || x > i32::MAX as usize)
+        || d.iter()
+            .try_fold(1usize, |n, &x| n.checked_mul(x))
+            .is_none()
+    {
+        return Err(invalid("invalid/overflowed extents"));
+    }
+    Ok(d.to_vec())
+}
+fn bf(ctx: &(impl CudaLaunchContext + ?Sized), t: &Tensor, d: &[usize]) -> Result<CudaBuffer> {
+    tensor_storage(ctx, t, DType::BF16, d)
+}
+fn disjoint(y: &CudaBuffer, x: &CudaBuffer) -> Result<()> {
+    let a = y.ptr() as usize;
+    let b = x.ptr() as usize;
+    let ae = a
+        .checked_add(y.len())
+        .ok_or_else(|| invalid("address overflow"))?;
+    let be = b
+        .checked_add(x.len())
+        .ok_or_else(|| invalid("address overflow"))?;
+    if a < be && b < ae {
+        return Err(invalid("output aliases input"));
+    }
+    Ok(())
+}
+
+/// NHWC input -> [OH*OW,KH*KW*C], zero padding. Weight order is ky,kx,c.
+pub fn im2col_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    y: &mut Tensor,
+    k: [usize; 2],
+    stride: [usize; 2],
+    padding: [usize; 2],
+    out_hw: [usize; 2],
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 3
+        || k.iter()
+            .chain(stride.iter())
+            .any(|&v| v == 0 || v > i32::MAX as usize)
+        || padding
+            .iter()
+            .chain(out_hw.iter())
+            .any(|&v| v > i32::MAX as usize)
+    {
+        return Err(invalid("im2col geometry"));
+    }
+    let cols = k[0]
+        .checked_mul(k[1])
+        .and_then(|v| v.checked_mul(d[2]))
+        .ok_or_else(|| invalid("im2col overflow"))?;
+    let rows = out_hw[0]
+        .checked_mul(out_hw[1])
+        .ok_or_else(|| invalid("im2col rows overflow"))?;
+    if rows == 0 || cols > i32::MAX as usize {
+        return Err(invalid("im2col extent"));
+    }
+    let xb = bf(ctx, x, &d)?;
+    let yb = bf(ctx, y, &[rows, cols])?;
+    disjoint(&yb, &xb)?;
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_im2col(
+            xb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            d[2] as _,
+            k[0] as _,
+            k[1] as _,
+            stride[0] as _,
+            stride[1] as _,
+            padding[0] as _,
+            padding[1] as _,
+            out_hw[0] as _,
+            out_hw[1] as _,
+            s,
+        ))
+    })
+}
+/// NHWC spatial patchify. Channels are (c,r,q), q=row-inner, r=column-inner.
+pub fn patchify_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    y: &mut Tensor,
+    p: usize,
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 3 || p == 0 || p > 16 || d[0] % p != 0 || d[1] % p != 0 {
+        return Err(invalid("patchify geometry"));
+    }
+    let xb = bf(ctx, x, &d)?;
+    let yb = bf(ctx, y, &[d[0] / p, d[1] / p, d[2] * p * p])?;
+    disjoint(&yb, &xb)?;
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_patchify(
+            xb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            d[2] as _,
+            p as _,
+            s,
+        ))
+    })
+}
+/// AvgDown3D's first-frame shortcut: leading FT-1 zero frames, flatten
+/// [channel,time-inner,row-inner,col-inner] and group contiguous channels.
+pub fn avg_first_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    y: &mut Tensor,
+    co: usize,
+    fs: usize,
+    ft: usize,
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 3
+        || co == 0
+        || co > i32::MAX as usize
+        || ![1, 2].contains(&fs)
+        || ![1, 2].contains(&ft)
+        || d[0] % fs != 0
+        || d[1] % fs != 0
+        || d[2] * ft * fs * fs % co != 0
+    {
+        return Err(invalid("average geometry"));
+    }
+    let xb = bf(ctx, x, &d)?;
+    let yb = bf(ctx, y, &[d[0] / fs, d[1] / fs, co])?;
+    disjoint(&yb, &xb)?;
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_avg_first(
+            xb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            d[2] as _,
+            co as _,
+            fs as _,
+            ft as _,
+            s,
+        ))
+    })
+}
+/// F.normalize channel L2 in BF16, then BF16 sqrt(C) scale, BF16 gamma.
+pub fn l2_channel_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    g: &Tensor,
+    y: &mut Tensor,
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 2 || d[1] > 8192 {
+        return Err(invalid("L2 matrix geometry"));
+    }
+    let xb = bf(ctx, x, &d)?;
+    let gb = bf(ctx, g, &[d[1]])?;
+    let yb = bf(ctx, y, &d)?;
+    disjoint(&yb, &xb)?;
+    disjoint(&yb, &gb)?;
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_l2(
+            xb.ptr(),
+            gb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            s,
+        ))
+    })
+}
+/// Adjacent complex pairs, F32 cos/sin table [T,D/2,2], F64 products, BF16 output.
+pub fn adjacent_rope_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    f: &Tensor,
+    y: &mut Tensor,
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 3 || d[2] % 2 != 0 || d[2] > 1024 {
+        return Err(invalid("adjacent RoPE geometry"));
+    }
+    let xb = bf(ctx, x, &d)?;
+    let fb = tensor_storage(ctx, f, DType::F32, &[d[0], d[2] / 2, 2])?;
+    let yb = bf(ctx, y, &d)?;
+    disjoint(&yb, &xb)?;
+    disjoint(&yb, &fb)?;
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_rope(
+            xb.ptr(),
+            fb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            d[2] as _,
+            s,
+        ))
+    })
+}
+/// mode0: BF16(BF16(x*BF16(1+a))+b), mode1: BF16(x+BF16(a*b))
+/// with a,b row vectors for mode0; mode1 a row vector, b matrix.
+/// mode2: BF16(BF16(x-a)*b). Each BF16 boundary is explicit.
+pub fn affine_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    x: &Tensor,
+    a: &Tensor,
+    b: &Tensor,
+    y: &mut Tensor,
+    mode: u32,
+) -> Result<()> {
+    let d = dims(x)?;
+    if d.len() != 2 || mode > 2 {
+        return Err(invalid("affine matrix/mode"));
+    }
+    let vector = [d[1]];
+    let xb = bf(ctx, x, &d)?;
+    let ab = bf(ctx, a, &vector)?;
+    let bb = bf(ctx, b, if mode == 1 { &d } else { &vector })?;
+    let yb = bf(ctx, y, &d)?;
+    for input in [&xb, &ab, &bb] {
+        disjoint(&yb, input)?;
+    }
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_affine(
+            xb.ptr(),
+            ab.ptr(),
+            bb.ptr(),
+            yb.ptr(),
+            d[0] as _,
+            d[1] as _,
+            mode as _,
+            s,
+        ))
+    })
+}
+/// BF16 dense Q[Tq,H,D], K/V[Tk,H,D], optional I8 key visibility[Tk].
+/// FP32 scores and probabilities, BF16 output; all-masked rows return zero.
+pub fn masked_attention_bf16(
+    ctx: &(impl CudaLaunchContext + ?Sized),
+    q: &Tensor,
+    k: &Tensor,
+    v: &Tensor,
+    mask: Option<&Tensor>,
+    out: &mut Tensor,
+) -> Result<()> {
+    let d = dims(q)?;
+    let kd = dims(k)?;
+    if d.len() != 3 || kd.len() != 3 || d[1..] != kd[1..] || d[2] > 1024 || kd[0] > 1024 {
+        return Err(invalid("attention geometry"));
+    }
+    let qb = bf(ctx, q, &d)?;
+    let kb = bf(ctx, k, &kd)?;
+    let vb = bf(ctx, v, &kd)?;
+    let yb = bf(ctx, out, &d)?;
+    for x in [&qb, &kb, &vb] {
+        disjoint(&yb, x)?;
+    }
+    let mb = mask
+        .map(|m| tensor_storage(ctx, m, DType::I8, &[kd[0]]))
+        .transpose()?;
+    if let Some(m) = &mb {
+        disjoint(&yb, m)?;
+    }
+    with_launch_device(ctx, |s| unsafe {
+        status::check(apxinf_spatial_attention(
+            qb.ptr(),
+            kb.ptr(),
+            vb.ptr(),
+            mb.as_ref().map_or(std::ptr::null(), |m| m.ptr()),
+            yb.ptr(),
+            d[0] as _,
+            kd[0] as _,
+            d[1] as _,
+            d[2] as _,
+            s,
+        ))
+    })
+}
