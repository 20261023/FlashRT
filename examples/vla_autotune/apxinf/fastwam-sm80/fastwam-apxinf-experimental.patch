+"""CPU container/layout conversion of the existing eight formal NPZ cases.
+
+No model execution, synthetic data generation, or bundled input data.
+"""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from safetensors.numpy import save_file
+
+CASES = ("noise-20261112", "noise-20261113", "noise-20261114", "noise-20261115",
+         "image-minus0p1", "proprio-plus0p1", "context-minus0p0625", "mask-last-valid-off")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--npz-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+    if any(args.output.iterdir()):
+        raise ValueError("output must be empty; do not overwrite existing evidence")
+    for name in CASES:
+        with np.load(args.npz_dir / (name + ".npz"), allow_pickle=False) as data:
+            expected = {"input_image": (1, 3, 224, 448), "context": (1, 128, 4096),
+                        "context_mask": (1, 128), "proprio": (1, 8), "noise": (1, 32, 7)}
+            if any(data[key].shape != shape for key, shape in expected.items()):
+                raise ValueError(f"{name}: input profile differs from the measured LIBERO profile")
+            arrays = {"image": np.ascontiguousarray(data["input_image"][0].transpose(1, 2, 0)),
+                      "context": np.ascontiguousarray(data["context"][0]),
+                      "proprio": np.ascontiguousarray(data["proprio"].reshape(1, 8)),
+                      "noise": np.ascontiguousarray(data["noise"].reshape(32, 7)),
+                      # Foundation safetensors loader does not support I8 files.
+                      "mask": np.ascontiguousarray(data["context_mask"].reshape(128).astype(np.float32))}
+            save_file(arrays, str(args.output / (name + ".safetensors")))
+    (args.output / "inputs.json").write_text(json.dumps({"source": str(args.npz_dir), "cases": CASES,
+        "transform": "CPU image NCHW->NHWC before timing; values unmodified; runtime casts BF16; binary mask stored FP32"}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
