@@ -0,0 +1,86 @@
+//! Actual full FastWAM inference benchmark, not an operator/smoke/test program.
+//! Full graph: VAE38 + VideoDiT30 + ActionDiT30 xEuler20. Cached T5 input seam.
+use apxinf_core::{Backend, Result, Tensor};
+use apxinf_cuda::CudaBackend;
+use apxinf_model::fastwam::{FastWamInputs, FastWamModel, FastWamRunner};
+use std::{path::Path, sync::Arc, time::Instant};
+
+fn main() -> Result<()> {
+    let args = std::env::args().collect::<Vec<_>>();
+    if args.len() != 4 {
+        return Err(apxinf_core::Error::Other(
+            "fastwam_bench CHECKPOINT INPUTS OUTPUT.json".into(),
+        ));
+    }
+    let output = Path::new(&args[3]);
+    let start = Instant::now();
+    let backend = Arc::new(CudaBackend::new(0)?);
+    let model = apxinf_cuda::tuning::without_autotune(|| {
+        FastWamModel::load(Path::new(&args[1]), Arc::clone(&backend))
+    })?;
+    let runner = FastWamRunner::new(model);
+    let mut cases = Vec::new();
+    for name in [
+        "noise-20261112",
+        "noise-20261113",
+        "noise-20261114",
+        "noise-20261115",
+        "image-minus0p1",
+        "proprio-plus0p1",
+        "context-minus0p0625",
+        "mask-last-valid-off",
+    ] {
+        let (map, _) = apxinf_loader::safetensors::load_native(
+            &Path::new(&args[2]).join(format!("{name}.safetensors")),
+        )
+        .map_err(apxinf_core::Error::Other)?;
+        let get = |n: &str| -> Result<&Tensor> {
+            map.get(n)
+                .ok_or_else(|| apxinf_core::Error::Other(format!("missing {n}")))
+        };
+        let mask = get("mask")?
+            .to_f32_vec()?
+            .into_iter()
+            .map(|x| u8::from(x != 0.))
+            .collect::<Vec<_>>();
+        let inputs = FastWamInputs::from_host(
+            get("image")?,
+            get("context")?,
+            get("proprio")?,
+            get("noise")?,
+            &mask,
+        )?;
+        cases.push((name, inputs));
+    }
+    let mut plan = runner.prepare_native(&cases[0].1, true)?;
+    let preparation_ms = start.elapsed().as_secs_f64() * 1000.;
+    for _ in 0..8 {
+        plan.replay()?;
+        backend.synchronize()?;
+    }
+    let mut rows = Vec::new();
+    for (name, input) in &cases {
+        for repeat in 0..10 {
+            let wall = Instant::now();
+            plan.update(input)?;
+            backend.synchronize()?;
+            let core = Instant::now();
+            let result = plan.replay()?;
+            backend.synchronize()?;
+            let core_ms = core.elapsed().as_secs_f64() * 1000.;
+            let action = backend.to_cpu(&result)?.to_f32_vec()?;
+            let wall_ms = wall.elapsed().as_secs_f64() * 1000.;
+            if action.iter().any(|v| !v.is_finite()) {
+                return Err(apxinf_core::Error::Other(format!(
+                    "nonfinite full-model output {name}"
+                )));
+            }
+            eprintln!("full-native {name} repeat={repeat} graph_completion_wall_ms={core_ms:.6} input_graph_output_ms={wall_ms:.6}");
+            rows.push(serde_json::json!({"case":name,"repeat":repeat,"graph_completion_wall_ms":core_ms,"input_graph_output_ms":wall_ms,"action":action}));
+        }
+    }
+    let report = serde_json::json!({"implementation":"apxinf-native-fastwam-bf16","status":"experimental_not_functionally_accepted_no_tests_user_waiver","scope":"FULL normalized image + cachedT5 + proprio + VAE38 + VideoDiT30 + Euler20 ActionDiT30 + output","graph":"whole-model","gpu":backend.context().caps().device_name,"sm":backend.context().caps().sm,"horizon":32,"action_dim":7,"proprio_dim":8,"text_tokens":128,"image_hw":[224,448],"steps":20,"sigma_shift":5.,"preparation_ms":preparation_ms,"arena_used_bytes":plan.arena_used(),"warmup":8,"repeats":80,"rows":rows});
+    std::fs::write(output, serde_json::to_vec_pretty(&report).unwrap())
+        .map_err(|e| apxinf_core::Error::Other(e.to_string()))?;
+    Ok(())
+}
