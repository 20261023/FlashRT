@@ -0,0 +1,39 @@
+use super::{model::err, FastWamModel, FastWamRunner};
+use crate::{LoadOptions, LoadedModel, ModelPrecision};
+use apxinf_core::{Backend, Device, Result};
+use std::{path::Path, sync::Arc};
+pub(crate) fn load_registered(
+    path: &Path,
+    device: Device,
+    backend: Arc<dyn Backend>,
+    options: &LoadOptions,
+) -> Result<LoadedModel> {
+    if !matches!(device, Device::Cuda(_))
+        || !matches!(
+            options.precision,
+            ModelPrecision::Auto | ModelPrecision::Bf16
+        )
+        || options.config.is_some()
+        || options.synthetic.is_some()
+        || options.calibration_path.is_some()
+        || options.uniform_fp8_scale.is_some()
+        || options.text_weight_dtype.is_some()
+        || !options.assets.is_empty()
+        || !matches!(
+            options.model_variant.as_deref(),
+            None | Some("auto") | Some("bf16")
+        )
+    {
+        return Err(err("only the exported fixed LIBERO BF16 profile is supported; overrides/quantization/CPU are unsupported"));
+    }
+    let backend = crate::accelerator::cuda::downcast_arc(backend)
+        .ok_or_else(|| err("CUDA backend required"))?;
+    let root = if path.is_dir() {
+        path
+    } else {
+        path.parent()
+            .ok_or_else(|| err("checkpoint parent missing"))?
+    };
+    let model = apxinf_cuda::tuning::without_autotune(|| FastWamModel::load(root, backend))?;
+    Ok(LoadedModel::Vla(Box::new(FastWamRunner::new(model))))
+}
