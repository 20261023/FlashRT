+"""Actual full-model public-policy benchmark, not a test or smoke invocation.
+
+Must run inside an allocated GPU step. No reference models are executed.
+CPU FP32 NHWC layout is prepared BEFORE timing, unlike historical NCHW seam.
+"""
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+from apxinf.policies import AutoPolicy
+
+from prepare_inputs import CASES
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--npz-dir", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise ValueError("output already exists; do not overwrite measured evidence")
+    start = time.perf_counter()
+    policy = AutoPolicy.from_pretrained(args.checkpoint, normalized_output=True, model_variant="bf16")
+    cases = []
+    for name in CASES:
+        with np.load(args.npz_dir / (name + ".npz"), allow_pickle=False) as data:
+            observation = {"input_image": np.ascontiguousarray(data["input_image"][0].transpose(1, 2, 0)),
+                           "context": np.ascontiguousarray(data["context"][0]),
+                           "context_mask": np.ascontiguousarray(data["context_mask"].reshape(128)),
+                           "proprio": np.ascontiguousarray(data["proprio"].reshape(8))}
+            cases.append((name, observation, np.ascontiguousarray(data["noise"].reshape(32, 7))))
+    for _ in range(8):
+        policy.infer(cases[0][1], noise=cases[0][2])
+    preparation_ms = (time.perf_counter() - start) * 1000
+    rows = []
+    for name, observation, noise in cases:
+        for repeat in range(10):
+            start = time.perf_counter()
+            result = policy.infer(observation, noise=noise)
+            elapsed = (time.perf_counter() - start) * 1000
+            rows.append({"case": name, "repeat": repeat, "public_policy_wall_ms": elapsed,
+                         "model_reported_ms": result["timing"]["model_ms"],
+                         "action": np.asarray(result["actions"], dtype=np.float32).reshape(-1).tolist()})
+            print(name, repeat, elapsed, flush=True)
+    args.output.write_text(json.dumps({"implementation": "AutoPolicy->FastWamPolicy->existing ModelRunner->Rust AutoModel->native whole-model graph",
+        "scope": "FULL normalized-image/cachedT5/proprio->VAE/video/action20->normalized FP32 actions",
+        "seam": "CPU FP32 NHWC prepared before timing; historical project NCHW; no pure-backend ratio",
+        "status": "experimental_not_functionally_accepted_no_tests_user_waiver",
+        "preparation_with_8_warmups_ms": preparation_ms, "repeats": 80, "rows": rows}, indent=2))
+    policy.close()
+
+
+if __name__ == "__main__":
+    main()
