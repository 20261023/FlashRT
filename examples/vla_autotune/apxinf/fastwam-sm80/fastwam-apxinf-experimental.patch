+"""Experimental native LIBERO FastWAM, normalized cached-T5 tensor interface.
+
+Not a robot adapter: image resize, prompt/T5 encoding and normalization must be
+performed by the caller. No Torch/Transformers/external inference engine runs.
+The user waived tests for this port; this policy is NOT functionally accepted.
+"""
+from __future__ import annotations
+
+import time
+from collections.abc import Mapping
+from pathlib import Path
+
+import numpy as np
+
+from ..registry import register_policy
+
+
+def _array(value, shape, name):
+    value = np.asarray(value)
+    if value.shape != shape or not np.issubdtype(value.dtype, np.floating):
+        raise ValueError(f"{name} must be floating {shape}")
+    value = np.ascontiguousarray(value, dtype=np.float32)
+    if not np.isfinite(value).all():
+        raise ValueError(f"{name} must be finite in float32")
+    return value
+
+
+@register_policy("fastwam")
+class FastWamPolicy:
+    """Fixed224x448/cachedT5128/proprio8/H32A7/Euler20shift5 research seam."""
+
+    @classmethod
+    def from_pretrained(cls, checkpoint_dir, *, model_runner=None,
+                        normalized_output=False, device="cuda:0",
+                        model_variant="bf16"):
+        if normalized_output is not True:
+            raise ValueError("FastWamPolicy requires normalized_output=True; not robot commands")
+        if model_variant not in ("auto", "bf16"):
+            raise ValueError("only unquantized bf16 is supported")
+        if model_runner is None:
+            from apxinf import ModelRunner
+            model_runner = ModelRunner.load("fastwam", Path(checkpoint_dir),
+                                            device=device, precision="bf16",
+                                            model_variant=model_variant,
+                                            autotune=False)
+        if (model_runner.action_horizon, model_runner.action_dim,
+                model_runner.max_token_len) != (32, 7, 128):
+            raise ValueError("native runner does not match LIBERO H32/A7/T5128")
+        return cls(model_runner)
+
+    def __init__(self, model_runner):
+        self.model_runner = model_runner
+        self.action_horizon = 32
+        self.action_dim = 7
+        self.metadata = {"model_type": "fastwam", "model_variant": "bf16",
+                         "action_horizon": 32, "action_dim": 7,
+                         "proprio_dim": 8, "cached_t5_tokens": 128,
+                         "image_shape": [224, 448, 3], "num_steps": 20,
+                         "sigma_shift": 5.0, "action_domain": "normalized",
+                         "deployable": False, "functional_acceptance": False}
+
+    def infer(self, observation: Mapping, *, noise=None):
+        start = time.perf_counter()
+        image = _array(observation["input_image"], (224, 448, 3), "normalized NHWC image")
+        if np.any(image < -1) or np.any(image > 1):
+            raise ValueError("normalized input_image must be within [-1,1]")
+        context = _array(observation["context"], (128, 4096), "cached T5 context")
+        proprio = _array(observation["proprio"], (8,), "normalized proprio")
+        if noise is None:
+            raise ValueError("caller-supplied noise[32,7] is currently required")
+        noise = _array(noise, (32, 7), "noise")
+        mask = np.asarray(observation["context_mask"])
+        if mask.shape != (128,) or mask.dtype != np.bool_:
+            raise ValueError("context_mask must be bool[128]")
+        model_start = time.perf_counter()
+        result = self.model_runner._infer_preprocessed(
+            image.reshape(-1, 3), np.array([[1, 224, 448]], dtype=np.uint32),
+            np.zeros(128, dtype=np.uint32), np.ascontiguousarray(mask, dtype=np.uint8),
+            proprio, None, noise, language_features=context)
+        actions = np.array(result, dtype=np.float32, order="C", copy=True)
+        if actions.shape != (32, 7) or not np.isfinite(actions).all():
+            raise ValueError("native output must be finite float32[32,7]")
+        return {"actions": actions, "action_domain": "normalized",
+                "timing": {"model_ms": (time.perf_counter()-model_start)*1000,
+                           "total_ms": (time.perf_counter()-start)*1000}}
+
+    def close(self):
+        self.model_runner = None
