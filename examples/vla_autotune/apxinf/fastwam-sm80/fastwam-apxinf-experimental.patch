@@ -0,0 +1,116 @@
+"""CPU-only export for the exact experimental LIBERO native FastWAM profile.
+
+No model construction/inference. Does not distribute checkpoint data. This
+portable adapter is derived from the exporter used for job329256; the adapter
+itself has not been rerun under the user's no-additional-execution instruction.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import torch
+from safetensors.torch import save_file
+
+CHECKPOINT_SHA256 = "1000437cfcf55c000094f79a2600634c502bcb5b492476b94bf8509883a49579"
+VAE_SHA256 = "20eb789667fa5e60e7516bf509512f6cb61f01b0aa0695eadaea930c13892b36"
+REFERENCE_REVISION = "7faa71108368fbb3b6885649f112af607427a2d4"
+
+
+def sha256(path):
+    result = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(8 * 1024 * 1024), b""):
+            result.update(chunk)
+    return result.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--vae", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    checkpoint_digest, vae_digest = sha256(args.checkpoint), sha256(args.vae)
+    if checkpoint_digest != CHECKPOINT_SHA256 or vae_digest != VAE_SHA256:
+        raise ValueError("asset digest does not match the measured LIBERO profile")
+    args.output.mkdir(parents=True, exist_ok=True)
+    if any(args.output.iterdir()):
+        raise ValueError("output must be empty; existing evidence is never overwritten")
+    torch.set_num_threads(8)
+    # Hash-allowlisted private author assets only; do not load arbitrary pickle.
+    payload = torch.load(args.checkpoint, map_location="cpu", mmap=True, weights_only=False)
+    vae = torch.load(args.vae, map_location="cpu", mmap=True, weights_only=True)
+    if tuple(payload["mot"]["mixtures.action.action_encoder.weight"].shape) != (1024, 7):
+        raise ValueError("wrong action checkpoint variant")
+    if tuple(payload["proprio_encoder"]["weight"].shape) != (4096, 8):
+        raise ValueError("wrong proprio checkpoint variant")
+    shard, index, transforms = {}, {}, {}
+    shard_number, shard_bytes = 0, 0
+
+    def flush():
+        nonlocal shard, shard_number, shard_bytes
+        if not shard:
+            return
+        name = f"model-{shard_number:03d}.safetensors"
+        save_file(shard, str(args.output / name))
+        index.update({key: name for key in shard})
+        print("wrote", name, shard_bytes, flush=True)
+        shard, shard_number, shard_bytes = {}, shard_number + 1, 0
+
+    def emit(name, tensor, transform):
+        nonlocal shard_bytes
+        tensor = tensor.to(dtype=torch.bfloat16).contiguous()
+        size = tensor.numel() * 2
+        if shard_bytes + size > 512 * 1024 * 1024:
+            flush()
+        shard[name], shard_bytes = tensor, shard_bytes + size
+        transforms[name] = {"shape": list(tensor.shape), "dtype": "BF16", "transform": transform}
+
+    for name, tensor in payload["mot"].items():
+        name = name.removeprefix("mixtures.")
+        if name.startswith("video.head."):
+            continue
+        if tensor.ndim == 5:
+            if name != "video.patch_embedding.weight" or tuple(tensor.shape) != (3072, 48, 1, 2, 2):
+                raise ValueError("unexpected video convolution")
+            tensor = tensor[:, :, 0].permute(2, 3, 1, 0).reshape(192, 3072)
+            transform = "patch Conv3d OI1HW -> HWIO -> [192,3072]"
+        elif tensor.ndim == 2 and name.endswith(".weight"):
+            tensor, transform = tensor.t(), "linear OI -> IO"
+        else:
+            tensor, transform = tensor.reshape(-1), "flatten gamma/bias/modulation"
+        emit(name, tensor, transform)
+    for name, tensor in payload["proprio_encoder"].items():
+        emit("proprio." + name, tensor.t() if name == "weight" else tensor,
+             "linear OI -> IO" if name == "weight" else "identity")
+    for name, tensor in vae.items():
+        if not (name.startswith("encoder.") or name.startswith("conv1.")) or ".time_conv." in name:
+            continue
+        if tensor.ndim == 5:
+            out_channels = tensor.shape[0]
+            tensor = tensor[:, :, -1].permute(2, 3, 1, 0).reshape(-1, out_channels)
+            transform = "T1 zero-history causal3d last temporal slice; HWIO -> KN"
+        elif tensor.ndim == 4 and name.endswith(".weight"):
+            out_channels = tensor.shape[0]
+            tensor = tensor.permute(2, 3, 1, 0).reshape(-1, out_channels)
+            transform = "Conv2d OIHW -> HWIO -> KN"
+        else:
+            tensor, transform = tensor.reshape(-1), "flatten gamma/bias"
+        emit("vae." + name, tensor, transform)
+    flush()
+    (args.output / "model.safetensors.index.json").write_text(json.dumps({"metadata": {}, "weight_map": index}, indent=2))
+    config = {"model_type": "fastwam", "profile": "libero-current224x448-cachedt5-128-euler20-shift5",
+              "horizon": 32, "action_dim": 7, "proprio_dim": 8, "text_tokens": 128,
+              "text_dim": 4096, "video_layers": 30, "action_layers": 30, "dtype": "bf16"}
+    (args.output / "config.json").write_text(json.dumps(config, indent=2))
+    provenance = {"checkpoint": str(args.checkpoint), "checkpoint_sha256": checkpoint_digest,
+                  "vae": str(args.vae), "vae_sha256": vae_digest,
+                  "reference_revision": REFERENCE_REVISION, "transforms": transforms}
+    (args.output / "weight-provenance.json").write_text(json.dumps(provenance, indent=2))
+
+
+if __name__ == "__main__":
+    main()
