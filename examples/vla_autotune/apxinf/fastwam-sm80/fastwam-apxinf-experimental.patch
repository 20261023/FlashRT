@@ -0,0 +1,73 @@
+"""Arithmetic on saved outputs only. No model loading or model/test execution."""
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+
+
+def reference_rows(path):
+    with np.load(path, allow_pickle=False) as data:
+        ids = data["request_ids"].astype(str)
+        actions = data["actions"] if "actions" in data.files else np.stack(
+            [data[f"actions_{i:05d}"] for i in range(len(ids))])
+        result = {}
+        for case, value in zip(ids, actions):
+            result.setdefault(case, []).append(np.asarray(value, dtype=np.float64).reshape(-1))
+        return result
+
+
+def compare(rows, reference):
+    values = []
+    for row in rows:
+        actual = np.asarray(row["action"], dtype=np.float64)
+        candidates = reference[row["case"]]
+        expected = candidates[row["repeat"] % len(candidates)]
+        if actual.shape != expected.shape or not np.isfinite(actual).all() or not np.isfinite(expected).all():
+            return {"finite_and_compatible": False, "within_historical_proxy": False}
+        expected_norm, actual_norm = np.linalg.norm(expected), np.linalg.norm(actual)
+        values.append((float(np.linalg.norm(actual - expected) / max(expected_norm, 1e-30)),
+                       float(np.dot(actual, expected) / max(actual_norm * expected_norm, 1e-30)),
+                       float(np.max(np.abs(actual - expected)))))
+    l2, cosine, absolute = max(v[0] for v in values), min(v[1] for v in values), max(v[2] for v in values)
+    return {"finite_and_compatible": True, "max_relative_l2": l2, "min_cosine": cosine,
+            "max_abs": absolute, "within_historical_proxy": l2 <= 0.05 and cosine >= 0.999}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--native", type=Path, required=True)
+    parser.add_argument("--public", type=Path, required=True)
+    parser.add_argument("--author", type=Path, required=True)
+    parser.add_argument("--project", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise ValueError("output already exists; preserve previous evidence")
+    references = {"saved_author_compiled20": reference_rows(args.author),
+                  "saved_project_compiled20": reference_rows(args.project)}
+    report = {"scope": "saved-output arithmetic only; not a new model/testing gate",
+              "functional_acceptance": False, "deployment_status": "experimental_not_deployable",
+              "seam": "public CPU FP32 NHWC prepared before timing; historical NCHW; no pure-backend ratio",
+              "historical_proxy": {"max_relative_l2": 0.05, "min_cosine": 0.999}, "runs": {}}
+    for name, path, keys in (("native", args.native, ("graph_completion_wall_ms", "input_graph_output_ms")),
+                             ("public_policy", args.public, ("public_policy_wall_ms",))):
+        data = json.loads(path.read_text())
+        rows = data["rows"]
+        if not rows:
+            raise ValueError(f"no saved output rows in {path}")
+        entry = {"path": str(path), "samples": len(rows), "timing": {}, "comparison": {}}
+        for key in keys:
+            numbers = np.asarray([row[key] for row in rows], dtype=np.float64)
+            entry["timing"][key] = {"median_ms": float(np.median(numbers)),
+                                    "mean_ms": float(np.mean(numbers)),
+                                    "p95_ms": float(np.percentile(numbers, 95))}
+        for reference, values in references.items():
+            entry["comparison"][reference] = compare(rows, values)
+        report["runs"][name] = entry
+    # Aggregate report intentionally contains no raw input/action tensors.
+    args.output.write_text(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
